{
  "name": "trstprep-backend",
  "version": "2.0.0",
  "description": "Trstprep API Backend with Express and Local JSON Database",
  "main": "src/app-port5001.js",
  "type": "module",
  "scripts": {
    "start": "node --no-deprecation src/app-port5001.js",
    "dev": "node --no-deprecation --watch src/app-port5001.js",
    "worker": "node src/worker/index.js",
    "worker:dev": "node --watch src/worker/index.js",
    "seed": "node src/data/seeds/SeedService.js",
    "build": "echo \"No build step required for Node.js backend\"",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "lint": "eslint src/**/*.js",
    "clean": "node -e \"const fs=require('fs'); const path=require('path'); const rimraf=(dir)=>{try{if(fs.existsSync(dir)){fs.rmSync(dir,{recursive:true,force:true})}}catch(e){console.error('Failed to remove',dir,e.message)}}; rimraf('node_modules/.cache'); console.log('Clean completed.')\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/client-ses": "^3.1000.0",
    "@aws-sdk/client-sns": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.70.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "twilio": "^5.12.2",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^10.0.0",
    "globals": "^15.14.0"
  },
  "overrides": {
    "qs": "6.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
