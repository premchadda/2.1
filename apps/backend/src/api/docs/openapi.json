{
  "openapi": "3.0.3",
  "info": {
    "title": "Trstprep API",
    "version": "2.1.0",
    "description": "PARTIAL scaffold of the Trstprep backend API. Only a representative subset of endpoints is documented here; many routes exist in the codebase but are not yet described. Auth is via JWT (HTTP Bearer or the `token` cookie)."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token supplied in the Authorization header (e.g. `Authorization: Bearer <token>`)."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token",
        "description": "Session JWT stored in the `token` cookie, set on login. Used as an alternative to the Bearer header."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "object",
            "properties": {
              "token": { "type": "string" },
              "refreshToken": { "type": "string" },
              "user": { "$ref": "#/components/schemas/User" }
            }
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" },
          "role": { "type": "string", "enum": ["user", "admin", "super_admin"] },
          "isActive": { "type": "boolean" },
          "isProUser": { "type": "boolean" }
        }
      },
      "TestSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "status": { "type": "string" },
          "duration": { "type": "number" },
          "totalQuestions": { "type": "integer" },
          "isProRestricted": { "type": "boolean" }
        }
      },
      "TestListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "count": { "type": "integer" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TestSummary" }
          }
        }
      },
      "TestDetail": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "seriesId": { "type": "integer" },
          "duration": { "type": "number" },
          "totalQuestions": { "type": "integer" },
          "totalMarks": { "type": "number" },
          "hasAccess": { "type": "boolean" }
        }
      },
      "TestDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/TestDetail" }
        }
      },
      "SubmitTestRequest": {
        "type": "object",
        "properties": {
          "attemptId": { "type": "string" },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "questionId": { "type": "string" },
                "selectedOption": { "type": "integer" },
                "questionIndex": { "type": "integer" }
              }
            }
          },
          "timeSpent": { "type": "number" },
          "markedForReview": { "type": "array", "items": { "type": "integer" } },
          "sectionTimers": { "type": "object" },
          "currentSection": { "type": "string" }
        }
      },
      "SubmitTestResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "object",
            "properties": {
              "attemptId": { "type": "string" },
              "score": { "type": "number" },
              "totalMarks": { "type": "number" },
              "correct": { "type": "integer" },
              "wrong": { "type": "integer" },
              "unattempted": { "type": "integer" },
              "accuracy": { "type": "number" },
              "antiCheat": { "type": "object" }
            }
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "action": { "type": "string" },
          "entityType": { "type": "string" },
          "entityId": { "type": "string" },
          "userId": { "type": "integer" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuditLogsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AuditLog" }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total": { "type": "integer" },
              "totalPages": { "type": "integer" }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "status": { "type": "string", "example": "online" },
          "version": { "type": "string", "example": "2.1.0" },
          "db": { "type": "object" },
          "redis": { "type": "object" },
          "queue": { "type": "object" }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate a user and issue JWT tokens",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid credentials payload",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Invalid email or password",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "Too many authentication attempts",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh an access token using a refresh token",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } }
          },
          "401": {
            "description": "Invalid or expired refresh token",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/tests": {
      "get": {
        "summary": "List all active and published tests",
        "tags": ["Tests"],
        "security": [],
        "responses": {
          "200": {
            "description": "List of tests",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TestListResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/tests/{id}": {
      "get": {
        "summary": "Get details for a single test",
        "tags": ["Tests"],
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Test identifier (numeric id, _id, or slug)"
          }
        ],
        "responses": {
          "200": {
            "description": "Test details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TestDetailResponse" } } }
          },
          "404": {
            "description": "Test not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/tests/{testId}/submit": {
      "put": {
        "summary": "Submit a completed test attempt",
        "tags": ["Tests"],
        "security": [
          { "bearerAuth": [] },
          { "cookieAuth": [] }
        ],
        "parameters": [
          {
            "name": "testId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Test identifier (numeric id, _id, or slug)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SubmitTestRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission accepted and evaluated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SubmitTestResponse" } } }
          },
          "400": {
            "description": "Invalid submission (e.g. time exceeds duration)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Not authenticated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Pro Pass required or not authorized",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "Test or attempt not found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "Attempt already submitted",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/admin/audit-logs": {
      "get": {
        "summary": "List paginated audit logs (admin only)",
        "tags": ["Admin"],
        "security": [
          { "bearerAuth": [] },
          { "cookieAuth": [] }
        ],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "entity_type", "in": "query", "schema": { "type": "string" } },
          { "name": "user_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated audit logs",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditLogsResponse" } } }
          },
          "401": {
            "description": "Not authenticated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "Not authorized as admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "Internal server error",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service health check",
        "tags": ["System"],
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "500": {
            "description": "Service degraded",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "503": {
            "description": "Service unavailable (e.g. database down)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  }
}
