# Backend environment variables (do not commit actual values)
# Copy this file to .env and fill in your actual values

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Format: postgresql://username:password@hostname:port/database_name
# If db.<project-ref>.supabase.co:5432 times out on your network, use the Supabase pooler URL from Dashboard -> Database -> Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
# Read replica URL for read-heavy operations (optional - falls back to DATABASE_URL if not set)
# For Supabase: Enable read replicas in Dashboard -> Database -> Replication
DATABASE_READ_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
USE_PUBLIC_ID=true
ALLOW_LEGACY_ID=true
LEGACY_ID_SUNSET_DATE=2026-06-01

# Redis / Queue (optional for API, required for worker)
# Local dev uses the bundled compose `redis` service (redis://redis:6379) or a
# local Redis at localhost:6379; without Redis the API falls back to in-memory
# cache and disables BullMQ queues + the Socket.IO Redis adapter automatically.
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# Connection tuning (see src/infrastructure/cache/redisClient.js):
# REDIS_CONNECT_TIMEOUT_MS=3000
# REDIS_COMMAND_TIMEOUT_MS=750
# REDIS_MAX_RETRIES_PER_REQUEST=1
# REDIS_TLS=true                      # for rediss:// managed endpoints (Upstash/ElastiCache)

# Worker queue concurrency
WORKER_ANALYTICS_CONCURRENCY=4
WORKER_LEADERBOARD_CONCURRENCY=2
WORKER_NOTIFICATIONS_CONCURRENCY=5
WORKER_RECOMMENDATIONS_CONCURRENCY=2

# Storage provider (local | s3 | supabase)
STORAGE_PROVIDER=local
BASE_URL=https://localhost:5001
SIGNED_URL_TTL_SECONDS=3600
STORAGE_BASE_PATH=assets

# AWS S3 settings (required when STORAGE_PROVIDER=s3)
# Also works with Cloudflare R2, Backblaze B2, and other S3-compatible providers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
S3_ACL=private
# For Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT blank
S3_ENDPOINT=
# Custom public URL for serving files (e.g. R2 custom domain or Cloudflare Worker)
# If set, public URLs use this base instead of S3_ENDPOINT
S3_PUBLIC_URL=

# Supabase storage settings (required when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ─── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 random characters in production
# CRITICAL: JWT_SECRET and JWT_REFRESH_SECRET MUST be different values
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET_GENERATE_WITH_COMMAND_ABOVE
JWT_REFRESH_SECRET=YOUR_SEPARATE_REFRESH_TOKEN_SECRET_MUST_BE_DIFFERENT_FROM_JWT_SECRET
# Dedicated secrets per token purpose (fail-closed at boot via env-validation.mjs).
# Fall back to JWT_SECRET only during rotation windows — set all three in production.
JWT_2FA_SECRET=
JWT_RESET_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# Server-side user & admin idle timeout (minutes). If a session records
# no activity for this long, the backend rejects requests with
# 401 "Session expired due to inactivity". Defaults to 4320 (3 days).
SESSION_IDLE_TIMEOUT_MIN=4320
ADMIN_IDLE_TIMEOUT_MIN=4320

# ─── Auth Cookies ──────────────────────────────────────────────────────────
# Cookie SameSite policy. 'lax' (default) works for same-site / subdomain deployments.
# Use 'none' for fully cross-site deployments (e.g. Vercel frontend + Render backend),
# and ONLY together with COOKIE_SECURE=true (or NODE_ENV=production/staging).
# AUTO: When NODE_ENV=production or COOKIE_SAMESITE is unset, defaults to 'none'.
COOKIE_SAMESITE=none
# Shared cookie domain so the auth cookie is sent across subdomains
# (e.g. admin.example.com + api.example.com). Leave blank for host-only cookies.
# Must include the leading dot for subdomains: .example.com
COOKIE_DOMAIN=
# Force Secure flag on cookies (HTTPS only). Auto-enabled in production/staging.
COOKIE_SECURE=true

# ─── AI (OpenRouter / OpenAI) ─────────────────────────────────────────────────
# Required for smart revision plans, AI search, and embedding features
# Get a free API key from https://openrouter.ai/keys
AI_API_KEY=
# Alias used by the AI gateway client (either can be provided):
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=gpt-4
AI_BASE_URL=https://openrouter.ai/api/v1
# Per-user hourly caps (see middleware/aiRateLimiter.js):
AI_FREE_HOURLY_LIMIT=50
AI_PRO_HOURLY_LIMIT=500

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://localhost:3000
# Admin panel origin + guard keys (required in production — see
# middleware/origin.middleware.js; requests fail closed when ADMIN_API_KEY unset)
ADMIN_PANEL_URL=
ADMIN_API_KEY=
# ALLOWED_ORIGINS is documented in the "CORS / origin allowlist" section below.
ALLOWED_ADMIN_IPS=

# ─── CSRF (double-submit HMAC pepper) ─────────────────────────────────────────
CSRF_PEPPER=
# Legacy alias for CSRF_PEPPER (either can be provided):
CSRF_HMAC_PEPPER=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank to log emails to console in development.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# For Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_PASS=<api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display name + address used in the From: header
SMTP_FROM=Trstprep <noreply@trstprep.com>

# ─── Sentry ─────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── Payments (Razorpay) ────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── OAuth / Comms ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── PostgreSQL Connection Pool ─────────────────────────────────────────────
PG_SSL_REJECT_UNAUTHORIZED=true
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=30000
PG_POOL_MAX=20
PG_READ_POOL_MAX=10

# ─── PII Encryption at Rest (M14 / DPDP Act) ──────────────────────────────
# AES-256 key used to encrypt PII columns (phone/dob/location/etc.)
# in the database. Required in production (32+ chars, never reuse JWT_SECRET).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_ENCRYPTION_KEY=
# Legacy alias for DB_ENCRYPTION_KEY (either can be provided):
PGCRYPTO_KEY=

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=500

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Security / Ops (added by 2026-09-19 audit) ─────────────────────────────
# Constant-time-compared Bearer token for GET /metrics. REQUIRED in production
# (the endpoint refuses to serve without it). Prometheus config:
#   authorization: { credentials: <this value> }
METRICS_AUTH_TOKEN=
# Comma-separated admin IPs allowed to hit /api/admin/* (empty = allow all).
ADMIN_IP_ALLOWLIST=
# Supabase service-role key — server-only, bypasses RLS. Never expose to clients.
SUPABASE_SERVICE_KEY=

# ─── Email / SMS providers ──────────────────────────────────────────────────
# One of: console | smtp | sendgrid | aws-ses
EMAIL_PROVIDER=console
# One of: console | twilio
SMS_PROVIDER=console

# NOTE: two email transports are in use and they read different variables.
#   infrastructure/email/emailService.js  -> SMTP_HOST/PORT/USER/PASS/SMTP_FROM
#   services/EmailService.js              -> FROM_EMAIL/FROM_NAME/SMTP_PASSWORD/
#                                           SMTP_SECURE/SMTP_FROM_ADDRESS/SMTP_FROM_NAME
# Fill both sets (or the subset each transport needs) to avoid silent 500s.
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
FROM_EMAIL=noreply@trstprep.com
FROM_NAME=Trstprep
EMAIL_SPOOL_DIR=./storage/email-spool

# ─── Redis (BullMQ + Socket.IO adapter + caches) ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_COMMAND_TIMEOUT_MS=5000

# ─── AI gateway (OpenRouter / fallback) ─────────────────────────────────────
AI_RATE_LIMIT_MAX=100
AI_RATE_LIMIT_ENFORCE=true
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# ─── Queues / workers ───────────────────────────────────────────────────────
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_DELAY=2000
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false
WORKER_EVENTS_CONCURRENCY=5
IS_WORKER=false
INSTANCE_ID=

# ─── Performance / caching ──────────────────────────────────────────────────
DEFAULT_QUERY_LIMIT=50
RESPONSE_CACHE_TTL=60
FILE_CACHE_ENABLED=true
FILE_CACHE_PATH=./.cache
CACHE_IO_TIMEOUT_MS=2000
DB_LOG_QUERIES=false

# ─── Uploads / files ────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_UPLOAD_FILE_SIZE=10485760
UPLOAD_RATE_LIMIT_MAX=20
# Fail-closed storage: true = error if the configured provider is unreachable
STORAGE_FAIL_CLOSED=false

# ─── Docs / platform ────────────────────────────────────────────────────────
ENABLE_SWAGGER=true
ENABLE_SWAGGER_IN_PROD=false
ENFORCE_HTTPS=true
ADMIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AWS_LAMBDA_FUNCTION_NAME=
# FortSpy encrypted-video service
FORTSPY_URL=http://localhost:5002
FORTSPY_TIMEOUT=30000

# ─── CORS / origin allowlist ────────────────────────────────────────────────
# CORS_ORIGIN is a comma-separated origin allowlist read by middleware/origin.middleware.js
# and app-port5001.js. ALLOWED_ORIGINS is the newer name — set BOTH to the same value
# until the legacy key is retired, otherwise the allowlist resolves empty.
CORS_ORIGIN=
ALLOWED_ORIGINS=
# Comma-separated private/LAN hostnames permitted in development only.
ALLOWED_LAN_HOSTS=
# Absolute frontend origin used to build links in emails and notifications.
CLIENT_URL=http://localhost:3000
# Reject non-browser clients outright (browsers always send Sec-Fetch-Mode).
REQUEST_METHOD=

# ─── Optional integrations (see src/integrations/optionalIntegrations.js) ────
# Both are off by default and reported by GET /api/health in non-production.
# PDF ingestion additionally needs python3 with pymupdf4llm installed.
ENABLE_PDF_INGESTION=false
CLASSIFIER_ENDPOINT=
ENABLE_TAXONOMY_CLASSIFIER=false

# ─── Runtime toggles ────────────────────────────────────────────────────────
# Run schema migrations during boot (default true).
RUN_MIGRATIONS_AT_BOOT=true
# Skip connection-pool priming (useful for one-shot scripts/workers).
PRIME_DB_OFF=false
WARMUP_OFF=false
# Disable all rate limiters — tests/load-testing only, never in production.
DISABLE_RATE_LIMITER=false

# ─── AI gateway tuning ──────────────────────────────────────────────────────
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_DAILY_TOKEN_LIMIT=200000
# Optional direct-provider key used when OpenRouter is unavailable.
OPENAI_API_KEY=

# ─── Sessions ───────────────────────────────────────────────────────────────
SESSION_IDLE_REMEMBER_ME_TIMEOUT_MIN=43200
SESSION_ABSOLUTE_TIMEOUT_DAYS=30

# ─── Taxonomy ───────────────────────────────────────────────────────────────
# Comma-separated difficulty levels offered by the question builder.
QUESTION_DIFFICULTY_LEVELS=easy,medium,hard
