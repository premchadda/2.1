# Backend environment variables (do not commit actual values)
# Copy this file to .env and fill in your actual values

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Format: postgresql://username:password@hostname:port/database_name
# If db.<project-ref>.supabase.co:5432 times out on your network, use the Supabase pooler URL from Dashboard -> Database -> Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
# Read replica URL for read-heavy operations (optional - falls back to DATABASE_URL if not set)
# For Supabase: Enable read replicas in Dashboard -> Database -> Replication
DATABASE_READ_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
USE_PUBLIC_ID=true
ALLOW_LEGACY_ID=true
LEGACY_ID_SUNSET_DATE=2026-06-01

# Redis / Queue (optional for API, required for worker)
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Worker queue concurrency
WORKER_ANALYTICS_CONCURRENCY=4
WORKER_LEADERBOARD_CONCURRENCY=2
WORKER_NOTIFICATIONS_CONCURRENCY=5
WORKER_RECOMMENDATIONS_CONCURRENCY=2

# Storage provider (local | s3 | supabase)
STORAGE_PROVIDER=local
BASE_URL=https://localhost:5001
SIGNED_URL_TTL_SECONDS=3600
STORAGE_BASE_PATH=assets

# AWS S3 settings (required when STORAGE_PROVIDER=s3)
# Also works with Cloudflare R2, Backblaze B2, and other S3-compatible providers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
S3_ACL=private
# For Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: leave S3_ENDPOINT blank
S3_ENDPOINT=
# Custom public URL for serving files (e.g. R2 custom domain or Cloudflare Worker)
# If set, public URLs use this base instead of S3_ENDPOINT
S3_PUBLIC_URL=

# Supabase storage settings (required when STORAGE_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ─── JWT Authentication ────────────────────────────────────────────────────────
# IMPORTANT: Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 random characters in production
# CRITICAL: JWT_SECRET and JWT_REFRESH_SECRET MUST be different values
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET_GENERATE_WITH_COMMAND_ABOVE
JWT_REFRESH_SECRET=YOUR_SEPARATE_REFRESH_TOKEN_SECRET_MUST_BE_DIFFERENT_FROM_JWT_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
# Server-side user & admin idle timeout (minutes). If a session records
# no activity for this long, the backend rejects requests with
# 401 "Session expired due to inactivity". Defaults to 4320 (3 days).
SESSION_IDLE_TIMEOUT_MIN=4320
ADMIN_IDLE_TIMEOUT_MIN=4320

# ─── Auth Cookies ──────────────────────────────────────────────────────────
# Cookie SameSite policy. 'lax' (default) works for same-site / subdomain deployments.
# Use 'none' for fully cross-site deployments (e.g. Vercel frontend + Render backend),
# and ONLY together with COOKIE_SECURE=true (or NODE_ENV=production/staging).
# AUTO: When NODE_ENV=production or COOKIE_SAMESITE is unset, defaults to 'none'.
COOKIE_SAMESITE=none
# Shared cookie domain so the auth cookie is sent across subdomains
# (e.g. admin.example.com + api.example.com). Leave blank for host-only cookies.
# Must include the leading dot for subdomains: .example.com
COOKIE_DOMAIN=
# Force Secure flag on cookies (HTTPS only). Auto-enabled in production/staging.
COOKIE_SECURE=true

# ─── AI (OpenRouter / OpenAI) ─────────────────────────────────────────────────
# Required for smart revision plans, AI search, and embedding features
# Get a free API key from https://openrouter.ai/keys
AI_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=gpt-4
AI_BASE_URL=https://openrouter.ai/api/v1

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://localhost:3000

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Leave blank to log emails to console in development.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# For Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_PASS=<api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Display name + address used in the From: header
SMTP_FROM=Trstprep <noreply@trstprep.com>

# ─── Sentry ─────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── PostgreSQL Connection Pool ─────────────────────────────────────────────
PG_SSL_REJECT_UNAUTHORIZED=true
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PG_QUERY_TIMEOUT_MS=30000
PG_POOL_MAX=20
PG_READ_POOL_MAX=10

# ─── PII Encryption at Rest (M14) ──────────────────────────────────────────
# AES-256 key used by pgcrypto to encrypt PII columns (phone/dob/location/etc.)
# in the `users` table. Migration 088 created encrypt_pii()/trigger; the runtime
# pool sets this as the `app.pgcrypto_key` session config on every connection.
# If left blank, encryption is a NO-OP (columns stay NULL) and writes still work
# (migration 104). NEVER commit a real value; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PGCRYPTO_KEY=

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=500

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_BASE_PATH=./uploads

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
