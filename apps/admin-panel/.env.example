# Admin Panel Environment Variables

# API Base URL (runtime — used by the admin app to reach the backend)
# - Development: Leave empty to use relative URLs (Vite proxy forwards /api to the backend)
# - Production: Set to your actual backend URL (e.g., https://api.yourdomain.com)
VITE_API_URL=/api

# Backend URL (dev-server only — Vite proxy target for /api, /socket.io, /assets, /uploads)
# Only used by `vite.config.js` during local development. Not exposed to app code.
VITE_BACKEND_URL=http://localhost:5001

# Admin site URL (this app — port 3002; do NOT collide with frontend :3000)
VITE_ADMIN_SITE_URL=http://localhost:3002

# Main site URL (for View Site button)
VITE_MAIN_SITE_URL=http://localhost:3000

# Admin API Key (optional, will be removed in favor of cookie auth)
# VITE_ADMIN_API_KEY=

# --- Optional (warn-only if unset; see src/shared/lib/env-validation.js) ---
# Socket.IO URL (defaults to same-origin / backend proxy when unset)
# VITE_SOCKET_URL=http://localhost:5001
# Frontend/student portal URL (View Site + command-palette portal link target)
# VITE_FRONTEND_URL=http://localhost:3000
# VITE_STUDENT_PORTAL_URL=http://localhost:3000
# Sentry DSN for production error reporting (errorReporter stays no-op when unset)
# VITE_SENTRY_DSN=
# App version stamped into Sentry releases + about surfaces
# VITE_APP_VERSION=2.1.0
