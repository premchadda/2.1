# Admin Panel Environment Variables

# API Base URL for backend (leave empty in dev to leverage Vite proxy)
VITE_API_URL=http://localhost:5001

# Backend URL (for Vite proxy)
VITE_BACKEND_URL=http://localhost:5001

# Admin site URL
VITE_ADMIN_SITE_URL=http://localhost:3002

# Main site URL (for View Site button)
VITE_MAIN_SITE_URL=http://localhost:3000
