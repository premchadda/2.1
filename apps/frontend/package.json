    "autoprefixer": "^10.4.16",
    "eslint": "^10.0.0",
    "globals": "^15.14.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.3.0",
