# Frontend Environment Variables (Example)
# Copy this file to .env and fill in your values

# API Base URL (runtime — used by the app to reach the backend)
# - Development: Leave empty to use relative URLs (Vite proxy forwards /api to the backend)
# - Production (cross-origin): Set to your backend URL (e.g. https://api.yourdomain.com)
# - Production (proxied via Vercel rewrites): Use /api (relative)
VITE_API_URL=https://your-backend.onrender.com

# Backend URL (Vite proxy target for /api, /socket.io, /assets, /uploads in dev,
# PLUS a runtime fallback: app code reads it for socket connections
# (shared/hooks/useWebSocket.js) and asset URLs (shared/config/assets-config.js)
# when no dedicated VITE_SOCKET_URL/VITE_API_URL host is configured)
VITE_BACKEND_URL=http://localhost:5001

# WebSocket URL
# - Development: Use / (Vite proxy handles routing)
# - Production: Set to your actual WebSocket URL (e.g., https://api.yourdomain.com)
VITE_SOCKET_URL=/

# Admin Panel URL
# - Development: Use /admin (Vite proxy handles routing)
# - Production: Set to your actual admin panel URL
VITE_ADMIN_URL=/admin

# Google OAuth Client ID (leave empty to disable Google login)
VITE_GOOGLE_CLIENT_ID=

# Support contact (shown in Terms, Privacy, Refund, Maintenance pages)
VITE_SUPPORT_EMAIL=support@trstprep.com

# Public site URL (used for canonical URLs / SEO metadata)
VITE_SITE_URL=https://trstprep.com

# Max upload file size in MB (used by src/app/config.js — default 10)
VITE_MAX_FILE_SIZE_MB=10