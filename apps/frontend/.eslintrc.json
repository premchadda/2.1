{
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "camelcase": [
      "warn",
      {
        "properties": "always",
        "ignoreDestructuring": false,
        "ignoreGlobals": false,
        "ignoreImports": false
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"]
  }
}