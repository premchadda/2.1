.npm/
apps/frontend/node_modules/
apps/backend/node_modules/
apps/frontend/dist/
apps/backend/dist/
.vite/
dist/

# Environment files (CRITICAL - Never commit)
.env
.env.local
.env.*.local
apps/backend/.env
apps/frontend/.env
apps/admin-panel/.env
*.env

# Uploads and exports
uploads/
exports/
apps/backend/uploads/
apps/backend/exports/

# OS files
.DS_Store
Thumbs.db

