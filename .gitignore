# ===========================================
# PRODUCTION EXCLUSIONS
# ===========================================

# Node modules and build outputs
node_modules/
.npm/
.pnpm-store/
pnpm-debug.log*
package-lock.json
apps/*/node_modules/
packages/*/node_modules/
apps/frontend/dist/
apps/backend/dist/
apps/admin-panel/dist/
apps/*/dist/
dist/
.vite/
.turbo/
**/.turbo/

# Environment files (CRITICAL - Never commit)
.env
.env.local
.env.*.local
apps/backend/.env
apps/frontend/.env
apps/admin-panel/.env
*.env

# Uploads and exports
uploads/
exports/
storage/
apps/backend/uploads/
apps/backend/exports/
apps/backend/storage/
*.bak

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python cache
__pycache__/
*.pyc
*.pyo

# ===========================================
# DEVELOPMENT ONLY - NEVER DEPLOY
# ===========================================

# Documentation files (analysis, reports, audits)
# docs/  — tracked for public documentation

# Database files and archives
*.zip
*.sql.gz
Database.zip
data/
!apps/backend/src/data/
apps/backend/src/data/*
*.db
*.sqlite
ssc_cgl_prevyear_full.json
RRB_NTPC_*.json

# Test and debug scripts (if any remain outside _dev)
test-*.js
check-*.js
check_*.js
fix-*.js
run-*.js
*-test.js
*.test.js
*.spec.js
check-*.mjs
check_*.mjs
!**/__tests__/**


# ===========================================
# IDE AND EDITOR
# ===========================================
.idea/
.vscode/
*.swp
*.swo
*~

# ===========================================
# LOGS AND CACHE
# ===========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.parcel-cache/
.turbo/
.qoder/

# ===========================================
# BUILD ARTIFACTS
# ===========================================
coverage/
.nyc_output/
*.tsbuildinfo
graphify-out/

# ===========================================
# LOCAL DEVELOPMENT FILES (Added by audit)
# ===========================================
# Local scripts that shouldn't be committed
*.cjs

# Scratch and temp files
scratch/
apps/backend/scratch/
apps/backend/src/uploads/
test_login_fetch.js
New Text Document.txt

# Sensitive backup files
dev-tools/backups/
dev-tools/*.backup

# Backend readiness signal
.backend-ready

# AI agent configs
.agents/
.codex/
.config/
TencentDB-Agent-Memory/
.git_commit_msg.txt
opencode_usage_*

# Graphify working artifacts (only graphify-out/ reports are useful, also ignored)
.graphify
.graphify/
.graphify_*
.graphify_backup/

# Accidental build/log leftovers
build_
build.out
build-out.txt
build_out*
build_output*
build_test.txt
build_final.txt
build_step2.txt
*.lint.out
lint.out
eslint_out*
eslint_output*
stats.html
db_live_inventory.txt

# Debug notes and temp text files
Trstprep Env File.txt
*.txt
!AGENTS.md
!CONTRIBUTING.md
!CHANGELOG.md

# Data artifacts at root
SSC_CGL_*.json
SSC_GK_*.md

# Accidental shell output files
$(*)

# QMS file (misplaced)
qms.jsx

# Standalone tools
archify/
agent-skills/

# Certificates and private keys
*.key
*.pem
deploy/nginx/certs/

# Python virtual environments & caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

