{"nodes": [{"id": "user_journey_comprehensive_doc", "label": "Trstprep User Journey Comprehensive Flow Diagram", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": null, "source_url": null, "captured_at": "2026-03-08", "author": null, "contributor": null, "rationale": "Comprehensive visualization of authentication, enrollment, and test-taking workflows for the Trstprep test-preparation platform"}, {"id": "guest_user_role", "label": "Guest User (Unauthenticated)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 670-687", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "registered_user_role", "label": "Registered User", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 670-687", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "pro_user_role", "label": "Pro User", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 670-687", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "admin_user_role", "label": "Admin", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 670-687", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "authentication_flow", "label": "Authentication Flow (Registration + Login)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 817-964", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses JWT in httpOnly cookies (XSS-protected) with sameSite=strict (CSRF-protected) and 7-day expiry"}, {"id": "jwt_token_strategy", "label": "JWT Token in httpOnly Cookie", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 893-925", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "httpOnly cookies prevent XSS token theft; sameSite='strict' prevents CSRF attacks; localStorage is a fallback for cross-origin scenarios"}, {"id": "enrollment_flow", "label": "Test Series Enrollment Flow", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 967-1112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision tree: not logged in -> login, logged in but not enrolled -> check pro/duplicate, already enrolled -> go to series; uses slug-or-id acceptance"}, {"id": "test_taking_flow", "label": "Test Taking Flow", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1114-1232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not Started -> In Progress -> Submitted -> Completed state machine; pro-required gating for premium tests"}, {"id": "test_score_calculation", "label": "Test Score Calculation with Negative Marking", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1186-1220", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Score = (correct * marksPerQuestion) - (wrong * negativeMarks); accuracy = (correct / (correct+wrong)) * 100"}, {"id": "hybrid_id_system", "label": "Hybrid ID System (SERIAL + Slug + _id mapping)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 780-813", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL SERIAL primary keys for DB; slugs for human-readable URLs; _id mapping exposes slug as id to frontend for compatibility. Frontend must NEVER send raw integer IDs; backend converts format for DB queries."}, {"id": "db_table_users", "label": "PostgreSQL Table: users", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1243-1279", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id SERIAL PK, name, email UNIQUE, password, role, is_pro, enrolled_series INTEGER[], email_verified"}, {"id": "db_table_test_series", "label": "PostgreSQL Table: test_series", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1281-1313", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id SERIAL PK, slug UNIQUE, title, category, total_tests, free_tests, is_pro"}, {"id": "db_table_tests", "label": "PostgreSQL Table: tests", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1315-1347", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id SERIAL PK, series_id FK -> test_series, title, duration (minutes), questions count, is_pro, is_live"}, {"id": "db_table_questions", "label": "PostgreSQL Table: questions", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1349-1377", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id SERIAL PK, test_id FK -> tests, question_text, options JSONB, correct_option INTEGER, explanation"}, {"id": "db_table_attempts", "label": "PostgreSQL Table: attempts", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1379-1416", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "id SERIAL PK, user_id FK -> users, test_id FK -> tests, score DECIMAL, correct, wrong, answers JSONB, is_completed"}, {"id": "api_endpoint_register", "label": "API: POST /api/auth/register", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1447-1452", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public endpoint to register a new user"}, {"id": "api_endpoint_login", "label": "API: POST /api/auth/login", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1453-1458", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public; logs user in and returns a JWT token"}, {"id": "api_endpoint_logout", "label": "API: POST /api/auth/logout", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1459-1464", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth required; logs the user out and clears the token cookie"}, {"id": "api_endpoint_me", "label": "API: GET /api/auth/me", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1465-1470", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth required; returns the current authenticated user's data"}, {"id": "api_endpoint_series_list", "label": "API: GET /api/series", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1475-1480", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public; lists all test series"}, {"id": "api_endpoint_series_detail", "label": "API: GET /api/series/:id", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1481-1486", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public; resolves a test series by numeric ID or slug (hybrid ID system)"}, {"id": "api_endpoint_series_tests", "label": "API: GET /api/series/:id/tests", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1487-1492", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public; lists tests contained in a series"}, {"id": "api_endpoint_enroll", "label": "API: POST /api/users/enroll/:seriesId", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1498-1502", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth required (protect middleware); accepts both numeric ID and slug; prevents duplicate enrollment"}, {"id": "api_endpoint_test_submit", "label": "API: PUT /api/tests/:testId/submit", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1549-1554", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth required; submits test answers, calculates score with negative marking, persists attempt row"}, {"id": "middleware_protect", "label": "Auth Middleware: protect", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1581-1635", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies JWT from Authorization Bearer header first, then httpOnly cookie; rejects with 401 if missing/invalid/inactive; attaches req.user"}, {"id": "middleware_optional_auth", "label": "Auth Middleware: optionalAuth", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1581-1587", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attaches user to request if a valid token is present, but does not block unauthenticated requests"}, {"id": "middleware_admin", "label": "Auth Middleware: admin", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1581-1587", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires the requester to have an admin role"}, {"id": "middleware_pro_pass", "label": "Auth Middleware: proPass", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1581-1587", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires an active Pro Pass subscription to access gated content"}, {"id": "password_security_bcrypt", "label": "Password Security (bcrypt)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1597-1603", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bcrypt hashing with 10 salt rounds; passwords never returned in API responses; reset tokens expire after 1 hour"}, {"id": "input_validation_express_validator", "label": "Input Validation (express-validator)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1589-1595", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "express-validator validates inputs; SQL injection prevented via parameterized queries; XSS prevented via output encoding"}, {"id": "error_handling_frontend_interceptor", "label": "Frontend Error Handling (dataService.js interceptor)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1744-1770", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralized axios-style response interceptor maps 400/401/403/404 to ValidationError/AuthenticationError/NotFoundError/DataError; on 401 clears localStorage token and dispatches 'unauthorized' event"}, {"id": "enrollment_state_transition", "label": "Enrollment State Machine", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1886-1910", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test Series Card button states: Login to Enroll -> Add Test Series -> View Series; Pro Test Access: Login Required -> Get Pro Pass -> Start Test"}, {"id": "auth_state_transition", "label": "Auth State Machine", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 928-963", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unauthenticated -> Login Request -> JWT Token -> Authenticated -> Logout -> Unauthenticated"}, {"id": "entity_relationship_diagram", "label": "Entity Relationships", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1418-1436", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "users ||--o{ attempts (takes); test_series ||--o{ tests (contains); tests ||--o{ questions (has); tests ||--o{ attempts (recorded in); users.enrolled_series INTEGER[] -> test_series.id (array-based, queryable with ANY())"}, {"id": "planned_enrollments_table", "label": "Planned: dedicated enrollments table", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 1934-1944", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace array-based enrolled_series with a dedicated table to track enrollment date, status, source, expiration, and history; enables cancellation flow and analytics"}, {"id": "planned_attempts_enhancement", "label": "Planned: attempts table enhancements", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\USER_JOURNEY_COMPREHENSIVE.html", "source_location": "lines 2019-2067", "source_url": null, "captur