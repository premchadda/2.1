nge(fourth.key)}\n                        className={`px-2 py-0.5 rounded-lg text-[13px] font-bold uppercase tracking-wider whitespace-nowrap transition-all flex-shrink-0 ${activeFourthCategory === fourth.key\n                          ? 'bg-gray-800 text-white shadow-sm'\n                          : 'bg-white text-gray-400 border border-gray-100 hover:border-gray-300'\n                          }`}\n                      >\n                        {fourth.label}\n                        {fourth.count > 0 && <span className=\"ml-1 opacity-60\">{fourth.count}</span>}\n                      </button>\n                    ))}\n                  </div>\n                );\n              })", "is_member_call": false, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\frontend\\src\\pages\\tests\\TestDetails.jsx", "source_location": "L1186"}, {"caller_nid": "tests_testdetails_testdetails", "callee": "map", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\frontend\\src\\pages\\tests\\TestDetails.jsx", "source_location": "L1224"}, {"caller_nid": "tests_testdetails_testdetails", "callee": "toUpperCase", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\frontend\\src\\pages\\tests\\TestDetails.jsx", "source_location": "L1263"}, {"caller_nid": "tests_testdetails_testdetails", "callee": "charAt", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\frontend\\src\\pages\\tests\\TestDetails.jsx", "source_location": "L1263"}, {"caller_nid": "tests_testdetails_testdetails", "callee": "map", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\frontend\\src\\pages\\tests\\TestDetails.jsx", "source_location": "L1284"}, {"caller_nid": "tests_testdetails_testdetails", "callee": "map", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\frontend\\src\\pages\\tests\\TestDetails.jsx", "source_location": "L1293"}, {"caller_nid": "tests_te