usersmanager_usersmanagerenhanced", "callee": "map", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L329"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "min", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L432"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "map", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L439"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "from", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L439"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "min", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L439"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "toUpperCase", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L472"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "charAt", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L472"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "toLocaleDateString", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L496"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "(() => {\n                const displayEnrollments = [...(viewingEnrollments?.enrollments || [])]\n                if (viewingUser?.isProUser) {\n                  displayEnrollments.unshift({\n                    id: 'synthetic-pro-pass',\n                    passType: viewingUser.passType || viewingUser.pass_type || 'Pro Pass',\n                    isPassPurchase: true,\n                    enrolledAt: viewingUser.updatedAt || viewingUser.createdAt\n                  })\n                }\n\n                return (\n                <>\n                  <h3 className=\"text-sm font-semibold text-gray-700 mb-3 flex items-center gap-2\">\n                    <CreditCard className=\"w-4 h-4 text-indigo-500\" />\n                    Enrollments & Purchases\n                  </h3>\n                  {enrollmentLoading ? (\n                    <div className=\"flex justify-center py-8\">\n                      <div className=\"animate-spin rounded-full h-8 w-8 border-4 border-indigo-500 border-t-transparent\"></div>\n                    </div>\n                  ) : displayEnrollments.length === 0 ? (\n                    <div className=\"text-center py-8 text-gray-400\">\n                      <CreditCard className=\"w-10 h-10 mx-auto mb-2 opacity-40\" />\n                      <p className=\"text-sm\">No enrollments found for this user</p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-3\">\n                      {displayEnrollments.map((enrollment, i) => (\n                        <div key={enrollment.id || i} className=\"flex items-start gap-3 p-3 rounded-xl border bg-gray-50 hover:bg-white transition-colors\">\n                          <div className=\"mt-0.5\">\n                            {enrollment.seriesName ? (\n                              <TestTube2 className=\"w-5 h-5 text-indigo-500\" />\n                            ) : enrollment.studyMaterialName ? (\n                              <BookOpen className=\"w-5 h-5 text-green-500\" />\n                            ) : (\n                              <Award className=\"w-5 h-5 text-yellow-500\" />\n                            )}\n                          </div>\n                          <div className=\"flex-1 min-w-0\">\n                            <p className=\"font-medium text-gray-900 text-sm\">\n                              {enrollment.seriesName || enrollment.studyMaterialName || 'Subscription Pass'}\n                            </p>\n                            <div className=\"flex flex-wrap gap-1.5 mt-1\">\n                              <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${enrollment.isPassPurchase || enrollment.passType === 'Pro Pass' ? 'bg-yellow-100 text-yellow-700' : 'bg-blue-100 text-blue-600'}`}>\n                                {enrollment.isPassPurchase ? `\u2b50 ${(enrollment.passType).split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}` : (enrollment.passType || 'Free')}\n                              </span>\n                              {enrollment.seriesName && (\n                                <span className=\"px-2 py-0.5 rounded-full text-xs bg-indigo-100 text-indigo-600\">Test Series</span>\n                              )}\n                              {enrollment.studyMaterialName && (\n                                <span className=\"px-2 py-0.5 rounded-full text-xs bg-green-100 text-green-600\">Study Material</span>\n                              )}\n                            </div>\n                          </div>\n                          <p className=\"text-xs text-gray-400 shrink-0 mt-0.5\">\n                            {enrollment.enrolledAt ? new Date(enrollment.enrolledAt).toLocaleDateString('en-IN') : ''}\n                          </p>\n                        </div>\n                      ))}\n                    </div>\n                  )}\n                </>\n                )\n              })", "is_member_call": false, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L515"}, {"caller_nid": "users_enrollments_usersmanager_usersmanagerenhanced", "callee": "map", "is_member_call": true, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\admin-panel\\src\\features\\admin\\users-enrollments\\UsersManager.jsx", "source_location": "L632"}]}