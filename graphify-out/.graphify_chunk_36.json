{"nodes": [{"id": "admin_router", "label": "admin.js Router", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "1:8352", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main Express Router aggregating all admin-facing API endpoints. Mounts split sub-modules and inline CRUD for ~30 resource types under /api/admin."}, {"id": "defense_in_depth_middleware", "label": "Defense-in-Depth Middleware Stack", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "65:80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5-layer security pipeline: origin restriction -> API key validation -> JWT auth -> admin role check -> audit logging. Pattern enforces layered security in fixed order."}, {"id": "normalize_fields_middleware", "label": "normalizeFields Middleware (camelCase->snake_case)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "61:63", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applied to POST/PUT/PATCH to convert request fields from camelCase to snake_case before validation, ensuring consistent DB column naming."}, {"id": "input_validation_schemas", "label": "Input Validation Schemas (testSeriesSchema, testSchema, questionSchema, userUpdateSchema, categorySchema)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "115:208", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chainable createSchema() instances define required fields, types, enums (mcq/msq/numerical/descriptive, easy/medium/hard), and bounds. Used with validateBody for Issue #29, #31."}, {"id": "csv_parser", "label": "CSV/Spreadsheet Parser (parseCsvLine, parseQuestionsCsv, parseQuestionsSpreadsheet, parseJson)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "234:299", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand-rolled RFC4180-ish CSV parser with quote-escape handling, plus XLSX parsing via xlsx-js-style and JSON fallback. Supports bulk upload of tests/questions."}, {"id": "bulk_row_mapper", "label": "Bulk Row Payload Mappers (mapBulkRowToQuestionPayload, mapBulkRowToTestPayload)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "301:500", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normalize header variants (option1/option_1/a), apply config fallbacks, slugify titles, parse booleans from yes/true/1 strings, split comma lists for tags/languages."}, {"id": "build_asset_url_map", "label": "Asset URL Map Builder (buildAssetUrlMap, attachTestBannerUrls, normalizeAssetRecord, inferAssetCategory)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "502:544,3075:3111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolve bannerAssetId/promotionBannerAssetId references to public URLs by joining assets table; infers category (image/video/pdf/document) from mime type."}, {"id": "fetch_questions_with_relations", "label": "fetchQuestionsWithRelations (single-query SQL JOIN)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "548:602", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FIX Q-02: Single SQL with LEFT JOIN on assets and subjects returns question + imageUrl + subjectName in one query, avoiding N+1 lookups."}, {"id": "cascade_orphan_flagging", "label": "Cascade Orphan Flagging Pattern", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "996:1054,1274:1330,3718:3761", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Soft-delete cascades set _orphaned=true, _deletedSeriesId/_deletedTestId/_orphanedExamCategoryId, orphanedAt timestamps so dependent rows can be cleaned up later. Also cleans test_category_series junction."}, {"id": "stage_resolution", "label": "Stage Resolution Logic (stageIds[] vs deprecated tier)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "1156:1199,1226:1265,3929:3977", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unifies stage linking: prefer stageIds[] array, fall back to legacy tier string -> stage name match. Logs deprecation warning when tier is used. Stage deletion blocks if any test references it via stageId/tier/stageIds array."}, {"id": "bulk_test_upload", "label": "Bulk Test Upload Endpoint (POST /tests/bulk)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "1332:1495", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts CSV/XLSX/JSON file or JSON array, maps each row to test payload, validates testCategoryId against DB, skips bad rows with reasons, then chunked insertMany in CHUNK_SIZE=500 batches to avoid PG parameter limits (FIX BUG-029)."}, {"id": "csv_export_stream", "label": "CSV Export Streaming (tests/export, questions/export)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "1501:1607,1647:1758", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streams CSV with BOM for Excel UTF-8 support, batches 1000 rows, joins test_questions junction to flatten test_id references for question export."}, {"id": "calculate_study_material_counts", "label": "calculateStudyMaterialCounts (dynamic counts)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "1762:1802", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregates chapters/videos/pdfs/topicTests counts on the fly; manual count fields in POST/PUT are stripped to prevent inconsistency."}, {"id": "update_study_material_counts_proc", "label": "update_study_material_counts SQL Procedure", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "2049:2051,2073:2075,2104:2106,2167:2169,2191:2193,2222:2224,2285:2287,2307:2309,2334:2336,2387:2389,2418:2420", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database function called after any chapter/video/pdf/topicTest mutation to recompute material aggregates server-side."}, {"id": "user_pii_sanitizer", "label": "sanitizeUser (SEC-12 PII Sanitization)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "2431:2442", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strips password, emailVerificationToken, resetPasswordToken etc. from any user object before sending to client. Applied to /users, /enrollments, /users/:id/pro-pass, /users/:id/role responses."}, {"id": "privilege_escalation_guard", "label": "Privilege Escalation Guard (PUT /users/:id/role)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "2537:2643", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocks self-demotion, requires super_admin for promoting/demoting between admin and user roles, logs blocked attempts to audit_logs with action='privilege_escalation_attempt'."}, {"id": "session_management", "label": "Session Management Endpoints", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "107:113,2676:2715,2719:2807,2810:2839", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin view of all user_sessions, revoke sessions, update session limit. Uses invalidateSession service which emits WebSocket event. Joins users for name/email/role context."}, {"id": "enrollments_aggregator", "label": "Enrollments Aggregator (GET /enrollments)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "2843:3007", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds per-user enrollment record by merging enrollments, testSeries, studyMaterials, exams, subscriptionPlans; computes passLabel/passBadge (Pro Yearly/Monthly/Free) from plan.period. Skips users with no enrollments."}, {"id": "paginated_results", "label": "Paginated Results Endpoint (FIX B10)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "3009:3072", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses SQL LIMIT/OFFSET + COUNT(*) for attempts, with LEFT JOIN users for name/email. Capped at 500/page. Maps snake_case and camelCase column variants to single output."}, {"id": "asset_unified_endpoint", "label": "Unified Asset Management (/assets, /media aliases)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "3074:3362", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single listAssets/handleAssetUpload logic exposed at both /assets and /media for backward compat. Supports category/type/search filters, pagination, soft delete with file cleanup via deleteStoredAssetFile."}, {"id": "hierarchical_categories", "label": "Hierarchical Test Categories (self-referential parentId)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "3396:3628", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "testCategories form a tree via parentId; level computed as parent.level+1; GET /path traverses ancestors for breadcrumbs; junction table test_category_series maps many-to-many with testSeries. delete recursively soft-deletes descendants."}, {"id": "stages_aggregates", "label": "Stage Aggregates (Stage.getAggregatesForStage)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "3769:3873", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines testCategories, tests, testSeries to compute categoryCount/seriesCount/testCount for each stage; resolves linked exams via coerceIdArray + idEquals."}, {"id": "exam_crud", "label": "Exams CRUD (POST/PUT/DELETE /exams)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "3991:4177", "source_url": null, "captured_at": null, "contributor": null, "rationale": "Unified subcategory-as-exam model. Validates parentCategoryId/examId uniqueness, looks up category to enrich response with parentCategoryName/Icon."}, {"id": "exam_seasons", "label": "Exam Seasons (year-wise exam sessions)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "4353:4482", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Year-tagged season records (notificationDate, applicationStartDate, examDate, resultDate, vacancyTotal, status) per exam."}, {"id": "sql_aggregated_analytics", "label": "SQL-Aggregated Analytics (FIX H2, B11)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "4541:4736", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces in-memory aggregations with SQL GROUP BY/COUNT/AVG on users/attempts. Computes daily users/tests, top tests, user growth rate vs previous period, avg completion rate, avg score."}, {"id": "deep_analytics", "label": "Deep Analytics (Funnel, Cohort, Engagement)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "7088:7299", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Funnel: registered->enrolled->attempted->completed->pro with conversion rates. Cohort: monthly user retention CTE. Engagement: composite score = testsCompleted*10 + avgScore*0.5 + bookmarks*2 + enrollments*5 bucketed into low/slightly/moderately/engaged/highly_engaged."}, {"id": "real_time_dashboard", "label": "Real-Time Dashboard (active-users, test-activity, revenue, system-health, live-feed)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "5549:5996", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Live activity rollups (5min/30min/1hr windows), hourly 24-bucket series, completion rate, avg score, top enrolled series. Revenue assumed as proUsers*999 INR (proPassPrice)."}, {"id": "system_health", "label": "System Health Endpoint (DB+Redis+CPU+Memory+Disk)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "5998:6063", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combined health check: SELECT 1 latency, redis getRedisStatus, os.cpus/loadavg/totalmem/freemem, execSync of wmic (win32) or df -k for disk usage. Two routes: /system-health and /health (alias)."}, {"id": "backup_system", "label": "Database Backup System (pg_dump + SQL fallback)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "6065:6496", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strategy 1: pg_dump -F c binary dump (preferred). Strategy 2 fallback: hand-built SQL INSERT statements for 35 tables when pg_dump unavailable. Restore via pg_restore or psql -f. Files written to ./backups dir."}, {"id": "curriculum_hierarchy", "label": "Curriculum Hierarchy CRUD (subjects/units/chapters/topics/subtopics)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "6920:7041", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generated routes for 5 entity types via curriculumCrudRoutes array. Each GET uses optimized SQL with explicit column projection (public_id as id, snake->camel) avoiding 10MB+ payloads. /chapters uses hard delete (dbHelpers.deleteById), others soft delete."}, {"id": "curriculum_orphan_detection", "label": "Curriculum Orphan Detection (ISSUE CU-03)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "4955:5059", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects units/chapters/topics/subtopics whose parent FK points to a missing record, with descriptive orphanedReason strings."}, {"id": "rbac_roles", "label": "RBAC Role System (super_admin, admin, content_manager, support, viewer)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "7451:7681", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default 5 roles with permission arrays. System roles (isSystem=true) cannot be modified or deleted. /permissions lists resource:action matrix (users/tests/questions/content/media/analytics/settings/roles/audit_logs)."}, {"id": "audit_log_system", "label": "Audit Log System (audit_logs table + auditMiddleware)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "7683:7896", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /audit-logs with filter+paginated SQL (action/tableName/userId/startDate/endDate), /stats endpoint, /export/csv (limited to 10000 rows). /:id must be registered after /stats and /export/csv to avoid route shadowing."}, {"id": "email_templates", "label": "Email Templates (with defaults fallback)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "7301:7449", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5 default templates (welcome_email, test_result, password_reset, subscription_confirmation, exam_reminder) returned when email_templates table query fails. /test endpoint logs instead of actually sending."}, {"id": "test_email_endpoint", "label": "Test SMTP Email Endpoint", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "6498:6557", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates SMTP config (host/port/username/password/fromEmail), creates nodemailer transporter, calls verify() then sendMail. Fallback returns 'looks valid' if nodemailer not installed."}, {"id": "bulk_reorder", "label": "Questions Bulk Reorder (POST /questions/bulk-reorder)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "8108:8165", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates question IDs against test_questions junction when testId provided, then UPDATE questions SET question_number, order_index for all in parallel via Promise.all."}, {"id": "question_conversion", "label": "Question Conversion (Practice <-> Test) (FIX PQ-01)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "8167:8270", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toggles is_practice flag. When converting to test, requires testId and INSERTs into test_questions junction. When to practice, DELETEs from junction. Bulk version via single UPDATE WHERE id IN (...)."}, {"id": "chapter_resources", "label": "Unified Chapter Resources View", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "8272:8350", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET /chapters/:id/resources returns chapter + videos + pdfs + notes (filtered by keywords 'note'/'handout'/'lecture note') + topic tests + related quizzes in single payload with counts."}, {"id": "bulk_reassign", "label": "Tests Bulk Reassign (POST /tests/bulk-reassign)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "8039:8106", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validates target testSeries/stage/testCategory exist, then per-test updateById with new seriesId/stageId/testCategoryId/category/subCategory."}, {"id": "stage_category_linking", "label": "Stage-Category Linking (PUT /stages/:id/categories)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "7995:8037", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operations: add/remove/replace categoryIds[] on a stage with dedup via Set."}, {"id": "bulk_series_operation", "label": "Test Series Bulk Operations (POST /test-series/bulk-operation)", "file_type": "code", "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "7899:7993", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operations: bulk-update, bulk-delete, bulk-toggle-active, bulk-toggle-pro, bulk-add-stages, bulk-remove-stages. Iterates seriesIds array calling updateById/softDelete."}], "edges": [{"source": "admin_router", "target": "defense_in_depth_middleware", "relation": "applies", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/backend/src/api/routes/admin.js", "source_location": "65:80", "weight": 1.0}, {"source": "admin_router", "target": "normalize_fields_middleware", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0