{"nodes": [{"id": "ContentManagement.jsx", "label": "ContentManagement Component", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "1-1269", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default-exported React component that orchestrates CRUD of curriculum content (videos, PDFs, notes, tests) under a Subject/Chapter/Topic hierarchy."}, {"id": "toSlug-helper", "label": "toSlug URL-safe slug generator", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "12-13", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure function that lowercases, trims, and replaces non-alphanumerics with dashes to produce a URL-safe slug from a title."}, {"id": "Hierarchy-StudyMaterial-Chapter-Topic", "label": "Curriculum Hierarchy (StudyMaterial > Chapter > Topic)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "21-23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-level ID-based selection state (selectedMaterialId, selectedChapterId, selectedTopicId) drives cascading sidebar dropdowns and content filtering."}, {"id": "Content-Type-Tabs", "label": "Content Type Tab System", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "28, 83-88", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four content types — videos, pdfs, notes (study materials), tests — each mapped to its own API endpoint, icon, and color class via a tabs[] array."}, {"id": "Endpoint-Map-Table", "label": "Per-Tab API Endpoint Map", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "91-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useCallback getEndpoint() switches on activeTab to return /admin/subject-videos, /admin/subject-pdfs, /admin/study-materials, or /admin/topic-tests."}, {"id": "handleFileUpload", "label": "Generic File Upload Handler", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "60-81", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "POSTs multipart/form-data to /api/admin/assets/upload with file, category, and name; returns server-issued public URL via setAdd(fieldKey, url)."}, {"id": "fetchContentItems", "label": "Filtered Content Fetcher", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "159-183", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useCallback that builds URLSearchParams from selectedMaterialId/chapterId/topicId and GETs the active tab's endpoint."}, {"id": "Cascading-Dropdowns-Pattern", "label": "Cascading Dropdown Pattern", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "121-156, 190-238, 273-292", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated useEffect chains: studyMaterial change resets and fetches chapters; chapter change resets and fetches topics. Sidebar and add/edit modals each maintain their own dropdown state."}, {"id": "Modal-Edit-Delete-Add", "label": "Modal Dialog Set (Edit, Delete, Add)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "724-1266", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three conditionally rendered modal sections — Edit (title/description + curriculum linking), Delete (confirmation), Add (per-tab payload form)."}, {"id": "Add-Payload-Schema-Dispatch", "label": "Per-Tab Add Payload Dispatch", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "375-445", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "handleAddSubmit switches on activeTab to build a type-specific payload (videos: videoUrl+thumbnail+duration+isPro, pdfs: pdfUrl+fileSize+pages+isPro, tests: testId+testType, notes: name+icon+order), with required-field validation."}, {"id": "Search-Filter-Pattern", "label": "Client-Side Search Filter", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "448-456", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "filteredContent matches case-insensitively against title, name, or description."}, {"id": "Sidebar-Data-Reuse", "label": "Sidebar-to-Modal Data Reuse", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "194-196, 220-222", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When the add modal picks the same studyMaterialId/chapterId as the sidebar, the already-loaded chapters/topics arrays are reused instead of refetching."}, {"id": "Drag-Drop-Upload-UI", "label": "Drag-and-Drop File Upload UI", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/ContentManagement.jsx", "source_location": "1031-1091, 1117-1147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dashed-border drop zones with onDragOver/onDrop handlers, plus a URL fallback input — same handl