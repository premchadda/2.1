{"nodes": [{"id": "CurriculumBuilder", "label": "CurriculumBuilder (React Component)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default-exported top-level React component that manages tiered curriculum hierarchy (Subject -> Unit -> Chapter -> Topic -> Subtopic) for the admin panel."}, {"id": "Toast", "label": "Toast (Notification Component)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Internal presentational component for transient success/error/info notifications; auto-dismisses after 4 seconds via setTimeout."}, {"id": "HIERARCHY_TABS", "label": "HIERARCHY_TABS (Tab Config Constant)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "65", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static array configuring the six sub-tabs (subjects, units, chapters, topics, subtopics, hierarchy) shown in the curriculum builder."}, {"id": "CHAPTER_CONTENT_TABS", "label": "CHAPTER_CONTENT_TABS (Chapter Tabs Config)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "144", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines the four resource sub-tabs inside a chapter view: videos, pdfs, notes, tests/quizzes, each with an icon and empty-state text."}, {"id": "LEVEL_EMOJI", "label": "LEVEL_EMOJI (Level Icon Map)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "132", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps each curriculum level ID to a unicode emoji glyph for visual decoration in cards and hierarchy view."}, {"id": "ICON_NAME_TO_EMOJI", "label": "ICON_NAME_TO_EMOJI (Lucide Icon Map)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "120", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps lucide-react icon names (kebab/snake case) to emoji fallbacks when no real image URL is provided for a subject/unit/chapter."}, {"id": "CurriculumHierarchy", "label": "Curriculum Hierarchy (5-level data model)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "177-275", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conceptual entity: Subject -> Unit -> Chapter -> Topic -> Subtopic. Chapters can also be 'direct chapters' (skipping the Unit level). IDs are matched across `id`, `_id`, and `public_id` to support both numeric DB ids and public-facing slugs."}, {"id": "naturalCompare", "label": "naturalCompare (Sort Comparator)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wrapper around `String.localeCompare` with `numeric: true` so embedded numbers are compared naturally ('Unit 2' < 'Unit 10')."}, {"id": "sortByOrderAndId", "label": "sortByOrderAndId (Stable Sort)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "108", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sorts curriculum items by `orderIndex` (or `order_index`) ascending, breaking ties via natural name sort and finally numeric entity id."}, {"id": "entityMatchesParentId", "label": "entityMatchesParentId (Parent Lookup Helper)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "84", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns true if an entity's id/_id/public_id equals the supplied parentId string after normalization; used throughout filtering logic."}, {"id": "IDNormalization", "label": "ID Normalization (camelCase + snake_case)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "78-100", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accessor helpers (`getUnitSubjectId`, `getChapterUnitId`, `getChapterSubjectId`, `getTopicChapterId`, `getSubtopicTopicId`, `getOrderIndex`) accept BOTH camelCase and snake_case keys from backend responses to support legacy data."}, {"id": "loadData", "label": "loadData (Async Data Fetcher)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "256", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parallel-fetches subjects/units/chapters/topics/subtopics in a single Promise.all. Accepts a `silent` flag to avoid the full-page spinner on mutation-driven refreshes (preserves tree stability)."}, {"id": "HierarchicalFiltering", "label": "Hierarchical Filter Chain", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "289-361", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useMemo-based cascade: filteredSubjects -> filteredUnits -> filteredChapters -> filteredTopics -> filteredSubtopics. Each stage only returns the rows whose parent ID set belongs to the previous stage, and the cascade also accepts chapters directly under a subject."}, {"id": "hierarchyTree", "label": "hierarchyTree (Nested Tree Builder)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "370", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useMemo that produces a nested `{ units: [...with chapters[...with topics[...with subtopics]]], directChapters: [...] }` tree from the filtered lists, using Map-based grouping keyed by normalized id."}, {"id": "openChapterView", "label": "openChapterView (Chapter Modal Loader)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "470", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens the chapter detail modal: builds a nested topics/subtopics list, derives notes from PDFs by type/keyword (CU-02 fix), and parallel-fetches videos/pdfs/topic-tests/quizzes."}, {"id": "handleReorder", "label": "handleReorder (Sibling Swap)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "892", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CB2 fix: reorders siblings inside a tab by swapping their orderIndex values via two parallel PUT requests. Disabled for 'subjects' and 'hierarchy' tabs."}, {"id": "handleReorderResource", "label": "handleReorderResource (Resource Swap)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "570", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reorders videos/pdfs/notes/tests inside a chapter via PUT /reorder endpoint. Performs an optimistic swap in local state before the network call, and recomputes the derived notes list when PDFs move."}, {"id": "validateSlug", "label": "validateSlug (Slug Uniqueness)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "867", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CU-04 fix: useCallback that returns an error string if the entered slug collides with any existing item in the current tab (excluding the item currently being edited)."}, {"id": "getDeleteDependencySummary", "label": "getDeleteDependencySummary", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "791", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes a human-readable count of nested dependents (units/chapters/topics/subtopics) for a delete-confirmation prompt."}, {"id": "handleSave", "label": "handleSave (CRUD Save Handler)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "708", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dispatches POST or PUT to the correct /api/admin/{tab} endpoint depending on whether `modalConfig.item` is set. Resolves the right parent (subjectId/unitId/chapterId/topicId) for each tab."}, {"id": "handleDelete", "label": "handleDelete (CRUD Delete Handler)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "841", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser confirm() prompt with dependency summary, then DELETE to /api/admin/{tab}/{id}, then silent refresh."}, {"id": "LocalStoragePersistence", "label": "LocalStorage Persistence (Collapsed Groups)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "208-226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CURR-LOW fix: collapsedGroups state is hydrated from and synced to `curriculum-collapsed-groups` key in localStorage with try/catch guarding against storage errors."}, {"id": "HierarchyExporter", "label": "Hierarchy Exporter (JSON + HTML)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "1204-1316", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two export functions: exportJSON serializes the current subject + hierarchyTree to a downloadable JSON file; exportHTML produces a styled, nested HTML report of the hierarchy."}, {"id": "NotesDerivation", "label": "Notes Derivation from PDFs (CU-02)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "531-551", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Notes are filtered from the PDFs list using either an explicit `type/pdfType/fileType` field ('note'/'notes'/'handout') or a keyword fallback over title/description/slug."}, {"id": "TopicContextFilter", "label": "Topic/Subtopic Context Filter", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "1081-1125", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`resourceMatchesTopicContext` hides chapter resources that don't match the currently selected topic/subtopic. Falls back to chapter-level visibility when the resource has no topic binding."}, {"id": "EscapeKeyHandler", "label": "Escape-to-Close Modal Handler", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "669-678", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useEffect that adds a window keydown listener for Escape when the chapter modal is open; cleanup removes the listener on close/unmount."}, {"id": "apiClient", "label": "apiClient (dataService.js)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Imported shared HTTP client; all GET/POST/PUT/DELETE calls flow through it."}, {"id": "AdminAPI_Subjects", "label": "Admin API: /api/admin/subjects", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "270", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint backing subject list/create/update/delete in the curriculum builder."}, {"id": "AdminAPI_Units", "label": "Admin API: /api/admin/units", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "271", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint backing unit CRUD."}, {"id": "AdminAPI_Chapters", "label": "Admin API: /api/admin/chapters", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "272", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint backing chapter CRUD."}, {"id": "AdminAPI_Topics", "label": "Admin API: /api/admin/topics", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint backing topic CRUD."}, {"id": "AdminAPI_Subtopics", "label": "Admin API: /api/admin/subtopics", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint backing subtopic CRUD."}, {"id": "AdminAPI_SubjectVideos", "label": "Admin API: /api/admin/subject-videos", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "525", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint fetching chapter-scoped videos (query: studyMaterialId, chapterId) and accepting a /reorder PUT for resource reordering."}, {"id": "AdminAPI_SubjectPdfs", "label": "Admin API: /api/admin/subject-pdfs", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "526", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint for PDFs (and derived notes). Also accepts /reorder PUT."}, {"id": "AdminAPI_TopicTests", "label": "Admin API: /api/admin/topic-tests", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "527", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "REST endpoint fetching topic-tests inside a chapter, also reorderable."}, {"id": "AdminAPI_Quizzes", "label": "Public API: /api/quizzes", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "528", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public quiz listing endpoint, filtered by subject name + active=true; not reorderable from this UI."}, {"id": "CurriculumBuilder_State", "label": "CurriculumBuilder State (useState bundle)", "file_type": "rationale", "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "179-252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composite state shape: data (5 lists), loading, activeTab, toast, slugError, reorderLoading Set, selectedSubjectId, collapsedGroups, modalConfig, formData, chapterView (open/chapter/subject/topics/resources)."}], "edges": [{"source": "CurriculumBuilder", "target": "Toast", "relation": "renders", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "2378", "weight": 1.0}, {"source": "CurriculumBuilder", "target": "HIERARCHY_TABS", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "1624", "weight": 1.0}, {"source": "CurriculumBuilder", "target": "CHAPTER_CONTENT_TABS", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "1996", "weight": 1.0}, {"source": "CurriculumBuilder", "target": "LEVEL_EMOJI", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "1427", "weight": 1.0}, {"source": "CurriculumBuilder", "target": "ICON_NAME_TO_EMOJI", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "apps/admin-panel/src/features/admin/study-materials/CurriculumBuilder.jsx", "source_location": "1757", "weight": 1.0}, {"source": "Curri