{"nodes": [{"id": "doc:docs/architecture/flows/FLOW_DASHBOARD.html", "label": "FLOW_DASHBOARD.html", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": null, "source_url": null, "captured_at": "2026-03-08T19:18:00", "author": null, "contributor": null, "rationale": "Concatenated HTML architecture document describing the Dashboard & User Environment Subsystem of Trstprep V2.0 with routes, components, API endpoints, database schema, and analytics calculation logic."}, {"id": "concept:DashboardSubsystem", "label": "Dashboard & User Environment Subsystem", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level subsystem enclosing personalized authentication gates, the global UI wrapper enforcing login layouts, deeply connected notification pulls, and user profile data-binding mappings to the Postgres database via Express APIs."}, {"id": "concept:ProtectedRoute", "label": "ProtectedRoute", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 223", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side React middleware component that consumes useAuth(), returns SkeletonLoader during loading, redirects unauthenticated users to /login via React-Router <Navigate replace>, and wraps children in a dashboard-layout div containing DashboardSidebar."}, {"id": "concept:AuthContext", "label": "AuthContext (useAuth hook)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single central truth-source hook used by every Dashboard sub-component and the ProtectedRoute middleware. Wraps the <Routes> element in App.jsx."}, {"id": "concept:App.jsx", "label": "App.jsx", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 220", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main React entry where AuthContext wraps the React-Router <Routes> element; declares all protected dashboard routes (/dashboard, /profile, /analysis, /admin, etc.) using <ProtectedRoute> wrappers."}, {"id": "concept:users.js-routes", "label": "users.js (Express routes file)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1113", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend Express routes module hosting GET/PUT /api/users/profile, POST /api/users/enroll/:seriesId, GET /api/users/enrolled-series, GET /api/users/analytics, GET /api/users/attempts."}, {"id": "concept:PostgresSupabase", "label": "PostgreSQL (Supabase)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1024", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary relational datastore used by the dashboard subsystem; 40+ tables; powers users, results, notifications, bookmarks, achievements."}, {"id": "concept:JWTValidationMiddleware", "label": "Express JWT Validation Middleware", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 285", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-side middleware that decodes the JWT and attaches req.user.user_id, which downstream controllers use to scope queries by the authenticated user."}, {"id": "concept:DashboardSidebar", "label": "DashboardSidebar", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 231", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sidebar wrapper component distinct from the marketing app, mounted inside the dashboard-layout div by ProtectedRoute; receives the authenticated user object as a prop."}, {"id": "concept:SkeletonLoader", "label": "SkeletonLoader", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loading-state placeholder component returned by ProtectedRoute while the AuthContext is still resolving the user."}, {"id": "concept:AdminLayout", "label": "AdminLayout", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1191", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Layout component rendered for the /admin route through a <ProtectedRoute adminOnly={true}> wrapper, enforcing role-based access in addition to authentication."}, {"id": "concept:ReactRouter", "label": "React Router", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 184", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-side routing library used to declare <Route> entries and perform reload-less <Navigate> redirects for unauthenticated users."}, {"id": "concept:ExpressAPI", "label": "Express REST API", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 281", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend HTTP layer under /api/users that mediates React dashboards to the Postgres database via JWT-authenticated controllers."}, {"id": "concept:Formik", "label": "Formik", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 300", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React form-handling library used by Profile.jsx to dump arbitrary key/value updates to PUT /api/users/profile, which the backend filters against an allowlist."}, {"id": "concept:PolymorphicBookmarkRelation", "label": "Polymorphic bookmark relationship", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 209", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema design where the bookmarks table holds item_type and item_id columns so a single table can reference Questions, Videos, or Test Series without a separate join table per type."}, {"id": "concept:AllowedUpdatesFilter", "label": "Allowed-updates filter (SQL-injection / privilege-escalation guard)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 303", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend security pattern on PUT /api/users/profile: req.body is reduced to a hard-coded allowlist ['name','phone','dob'], preventing role escalation and SQL-injection-style updates of arbitrary columns."}, {"id": "concept:dbHelpers", "label": "dbHelpers.find()", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1319", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helper utility used by the analytics handler in users.js to query the 'results' collection by userId and isCompleted."}, {"id": "page:Dashboard.jsx", "label": "Dashboard.jsx (src/pages/dashboard/Dashboard.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1047", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected dashboard home page; resolves the /dashboard route and consumes the global users/stats endpoint (attempts, accuracy, recent activity)."}, {"id": "page:Profile.jsx", "label": "Profile.jsx (src/pages/dashboard/Profile.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1054", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected page mounted at /profile; two-way binds Name/DOB/Mobile via Formik; issues GET then PUT /api/users/profile."}, {"id": "page:Settings.jsx", "label": "Settings.jsx (src/pages/dashboard/Settings.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1061", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected user-settings page listed in the dashboard route inventory."}, {"id": "page:Analysis.jsx", "label": "Analysis.jsx (src/pages/dashboard/Analysis.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1068", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected analysis page that visualizes aggregated user performance metrics from /api/users/analytics."}, {"id": "page:Bookmarks.jsx", "label": "Bookmarks.jsx (src/pages/dashboard/Bookmarks.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1075", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected page rendering the user's saved Questions, Videos, and Test Series using a polymorphic query against the bookmarks table."}, {"id": "page:AttemptedTests.jsx", "label": "AttemptedTests.jsx (src/pages/dashboard/AttemptedTests.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1082", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected page listing the user's prior test attempts, backed by /api/users/attempts."}, {"id": "page:Notifications.jsx", "label": "Notifications.jsx (src/pages/dashboard/Notifications.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1089", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected page rendering the user's notifications from the notifications table."}, {"id": "page:Achievements.jsx", "label": "Achievements.jsx (src/pages/dashboard/Achievements.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1096", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected page displaying achievements earned by the user, sourced from the achievements table."}, {"id": "page:ReferAndEarn.jsx", "label": "ReferAndEarn.jsx (src/pages/dashboard/ReferAndEarn.jsx)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protected referral page within the dashboard surface."}, {"id": "table:users", "label": "users table", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 244", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core users table with id UUID PK, name, email UNIQUE, password_hash, phone, is_pro_user/isProUser, role ENUM (user/admin), enrolledSeries ARRAY, isEmailVerified."}, {"id": "table:bookmarks", "label": "bookmarks table", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 257", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polymorphic bookmarks table referencing users(id) with item_type/item_id and created_at; second doc also lists userId + questionId FK to questions."}, {"id": "table:notifications", "label": "notifications table", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 268", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User-scoped notifications table with title, message, is_read/isRead, type, createdAt."}, {"id": "table:results", "label": "results table", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1231", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test-attempt results table with FK userId→users, FK testId→tests, score, correctAnswers, wrongAnswers, accuracy, timeSpent, isCompleted; primary source for analytics."}, {"id": "table:achievements", "label": "achievements table", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1286", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Achievements table keyed by userId, with type, title, description, earnedAt."}, {"id": "api:GET:/api/users/profile", "label": "GET /api/users/profile", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 284", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the authenticated user's profile (id, name, email, is_pro_user, preferences.target_exam). Never exposes password_hash. Uses req.user.user_id from JWT middleware."}, {"id": "api:PUT:/api/users/profile", "label": "PUT /api/users/profile", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 299", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Updates user profile fields (name, phone, dob/avatar per second doc) sourced from the Formik handler; applies allowedUpdates allowlist to block role escalation."}, {"id": "api:POST:/api/users/enroll/:seriesId", "label": "POST /api/users/enroll/:seriesId", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1129", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enrolls the authenticated user in a given test series."}, {"id": "api:GET:/api/users/enrolled-series", "label": "GET /api/users/enrolled-series", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the list of test series the current user is enrolled in."}, {"id": "api:GET:/api/users/analytics", "label": "GET /api/users/analytics", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1141", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregates completed results via dbHelpers.find to compute totalTests, avgAccuracy, avgScore, subjectWise breakdown and rank."}, {"id": "api:GET:/api/users/attempts", "label": "GET /api/users/attempts", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1147", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns the user's test attempts powering the AttemptedTests page."}, {"id": "metric:totalTests", "label": "totalTests (analytics metric)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1353", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Count of completed result rows returned by GET /api/users/analytics."}, {"id": "metric:avgAccuracy", "label": "avgAccuracy (analytics metric)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBOARD.html", "source_location": "line 1357", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean of (correctAnswers / totalQuestions * 100) across the user's completed results, rounded to integer percent."}, {"id": "metric:avgScore", "label": "avgScore (analytics metric)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\FLOW_DASHBO