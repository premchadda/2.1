{"nodes": [{"id": "entity_relationship_flowmap_html", "label": "Entity Relationship Flowmap", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": "2026-03-08T19:18:00", "author": null, "contributor": null, "rationale": "Visual HTML representation of the Topic-Centric Knowledge Graph and platform hierarchy for Trstprep V2.0; uses PostgreSQL/Supabase as the backing store."}, {"id": "exam_entity", "label": "Exam (Central Hub Entity)", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Central hub entity of the Trstprep platform; examples include SSC CGL, RRB NTPC. Acts as parent for all test series, quizzes, and study materials."}, {"id": "test_series_entity", "label": "Test Series Bundle", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bundle of tests organized into stages/tiers; examples include SSC CGL Mock Test Series 2026 (Tier I & Tier II). Hierarchy is defined via dynamic JSONB sections."}, {"id": "test_entity", "label": "Test", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Individual test in a series (mock, PYP, sectional, or chapter test). Composed of questions, solutions, and analytics."}, {"id": "quiz_entity", "label": "Quiz", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quick practice assessment. Can be exam-scoped (Daily GK Quiz) or topic-scoped (Topic Quizzes, Current Affairs). FK to exams is nullable to support topic-only quizzes."}, {"id": "study_material_entity", "label": "Study Material", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learning resource; includes Notes & PDFs, Video Lessons, Syllabus & Pattern. material_type is an ENUM field."}, {"id": "question_entity", "label": "Question", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atomic question unit; tagged with [Subject, Chapter, Topic]. difficulty is an ENUM. Mapped to tests via the test_questions junction table."}, {"id": "subject_entity", "label": "Subject", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mid-level taxonomy entity; children are Chapters, parent is Exam."}, {"id": "chapter_entity", "label": "Chapter", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Granular taxonomy entity; children are Topics, parent is Subject."}, {"id": "topic_entity", "label": "Topic", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowest common denominator of the Topic-Centric Knowledge Graph; links Questions, Quizzes, and Study Materials. Every Question is tagged with [Subject, Chapter, Topic]."}, {"id": "topic_centric_kg_pattern", "label": "Topic-Centric Knowledge Graph", "file_type": "rationale", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architectural decision: although Exam is the parent entity, learning is Topic-Centric. Topics are the lowest common denominator linking content across quizzes, questions, and study materials."}, {"id": "central_hub_design", "label": "Central Hub Design (Exam as Hub)", "file_type": "rationale", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visualization/architecture pattern: the Exam sits as the central entity with branches radiating to Test Series, Quizzes, and Study Materials via connection lines."}, {"id": "jsonb_sections_pattern", "label": "Dynamic JSONB Sections", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Data structure decision: test_series.sections is JSONB to allow flexible hierarchy (e.g., Tier I, PYP, Sectional) without schema migrations."}, {"id": "postgresql_supabase_db", "label": "PostgreSQL on Supabase", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database technology choice: PostgreSQL hosted on Supabase supports JSONB columns needed for dynamic test-series sections."}, {"id": "test_questions_junction", "label": "test_questions Junction Table", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Junction table that maps tests to questions in a M:N relationship. test_questions.test_id FK -> tests.id; questions can be reused across tests."}, {"id": "frontend_routes", "label": "Frontend Routes", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes: /exams/:slug, /exams/:slug/test-series, /test-series/:id, /tests/:id, /quizzes/:id, /study-materials/:id."}, {"id": "api_endpoints", "label": "Key API Endpoints", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Endpoints: GET /api/exams, GET /api/exams/:slug/test-series, GET /api/test-series/:id/tests, GET /api/exams/:slug/quizzes, GET /api/exams/:slug/materials."}, {"id": "one_to_many_relationship", "label": "One-to-Many (1:N) Relationship", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dominant relationship cardinality in the data model. Used for Exam->Test Series, Test Series->Test, Exam->Quiz, Exam->Study Material, Exam->Subject, Subject->Chapter, Chapter->Topic, Topic->Quiz/Question/Study Material."}, {"id": "many_to_many_relationship", "label": "Many-to-Many (M:N) Relationship", "file_type": "document", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test <-> Question is M:N, resolved through the test_questions junction table so a single question can belong to multiple tests."}, {"id": "knowledge_graph_taxonomy", "label": "Exam > Subject > Chapter > Topic Taxonomy", "file_type": "rationale", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hierarchical taxonomy forming the backbone of the topic-centric knowledge graph; each level is a 1:N parent of the next."}], "edges": [{"source": "entity_relationship_flowmap_html", "target": "exam_entity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "weight": 1.0}, {"source": "entity_relationship_flowmap_html", "target": "test_series_entity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\docs\\architecture\\flows\\ENTITY_RELATIONSHIP_FLOWMAP.html", "source_location": null, "weight": 1.0}, {"source": "entity_relationship_flowmap_html", "target": "test_entity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "so