{"nodes": [{"id": "tests_manager_component", "label": "TestsManager (React component, default export)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "line 309", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top-level React functional component orchestrating test CRUD, filtering, publishing, bulk actions, and cascading subcategory navigation within admin-panel."}, {"id": "test_category_tabs", "label": "TEST_CATEGORY_TABS (4-tab taxonomy: mock-tests, pyp, practice, live-tests)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 34-39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constant defining four mutually exclusive test types rendered as a tab bar, each with lucide-react icon."}, {"id": "test_category_aliases", "label": "TEST_CATEGORY_ALIASES (slug normalization map)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 48-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps each category id to accepted aliases (snake/kebab/case/words) used by buildTestCategoryRefs to perform fuzzy matching."}, {"id": "default_test_form", "label": "DEFAULT_TEST_FORM (initial form state)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 55-75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default values for the test create/edit form: title, slug, 4 subcategory levels, type, duration, negativeMarking, difficulty, isPro, isComingSoon, isLive, tags, stageIds, sectionIds, scheduledAt, maxParticipants."}, {"id": "normalize_test", "label": "normalizeTest (data shape tolerance helper)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 103-124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defensive normalizer that handles both camelCase and snake_case backend field names and supplies defaults for missing fields."}, {"id": "coerce_array", "label": "coerceArray (string/array/JSON coercion)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 126-140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helper that accepts arrays, single objects, JSON strings, Postgres-style '{a,b}' strings, or CSV strings and returns an array."}, {"id": "flatten_categories", "label": "flattenCategories (tree -> flat list with parentId)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 142-153", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recursively flattens nested children into a single array tagged with parentId for downstream BFS/DFS use."}, {"id": "build_test_category_refs", "label": "buildTestCategoryRefs (BFS expansion of category aliases + descendants)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 221-241", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Given an active category, expands aliases and walks the descendant tree to populate a Set of normalized id/name/slug refs used for membership tests."}, {"id": "build_category_selection_refs", "label": "buildCategorySelectionRefs (selected chip + descendants refs)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 250-274", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Like buildTestCategoryRefs but anchored on a specific selected subcategory; used by testMatchesSubCategory to include descendants in filtering."}, {"id": "get_category_path", "label": "getCategoryPath (root -> leaf path resolution)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 288-302", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Walks parent chain (with cycle protection) to reconstruct full hierarchy of a category for cascading dropdowns."}, {"id": "fetch_data", "label": "fetchData (parallel load via Promise.allSettled)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 357-414", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loads tests, series, stages, test categories, and sections in parallel using allSettled so partial failures surface as warnings rather than aborts."}, {"id": "cascading_subcategory_drilldown", "label": "Cascading subcategory drill-down (4 levels: L1..L4)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 460-512, 1354-1517", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four useMemo selectors + four chip rows that progressively filter by hierarchy level (Year/Exam -> 2025/2024 -> ...); includes duplicate-parent guard to avoid self-nesting."}, {"id": "deep_link_handler", "label": "Deep-link via URL search params (tab/seriesId/stageId)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 565-582", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "useEffect reads ?tab=, ?seriesId=, ?stageId= to restore active filters and select a series once data loads; guarded by deepLinkAppliedRef to apply only once."}, {"id": "open_create_form", "label": "openCreateForm (initialize new-test form state)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 708-729", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves cascading subcategory path for the currently selected chip, sets type/isLive based on activeTestCategory, and clears editingId."}, {"id": "open_edit_form", "label": "openEditForm (hydrate form from existing test)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 731-810", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves linked series/stage/category for a test, prioritizes specific categoryId fields over test.type, and populates the four subcategory levels while building an editingRelationshipSummary for the modal."}, {"id": "handle_submit", "label": "handleSubmit (validate + create/update test)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 812-897", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs validateForm(testSchema), builds a payload with conditional fields (scheduledAt, maxParticipants, tags, examId, stageIds), strips undefined/empty id-ish keys, and routes to adminAPI.createTest or adminAPI.updateTest."}, {"id": "handle_bulk_upload", "label": "handleBulkUpload (FormData upload of CSV/file)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 899-933", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packages file + testSeriesId/category/examId/stageId/testCategoryId/validateOnly into a FormData and calls adminAPI.bulkUploadTests, surfacing skipped counts in a toast."}, {"id": "validate_bulk_upload", "label": "validateBulkUpload (pre-flight duplicate + shape check)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 935-970", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Calls adminAPI.bulkUploadTests with validateOnly=true and augments server results with client-side duplicate-title and title-length checks."}, {"id": "handle_publish_unpublish", "label": "handlePublish / handleUnpublish (lifecycle toggle)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 985-1023", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refuses to publish when questionCount is 0; on success, updates the local test with status/active flags and re-derived totals/marks returned by the backend."}, {"id": "handle_export", "label": "handleExport (CSV download via blob URL)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 1025-1042", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Streams /api/admin/tests/export with responseType blob, wraps in a Blob and an anchor element to trigger CSV download; revokes the object URL after click."}, {"id": "bulk_actions_bar", "label": "Bulk publish / bulk delete floating action bar", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 1066-1113, 1606-1635", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Toggle per-test selection (Set), filter out unpublishable zero-question tests, call /api/admin/tests/bulk-publish and /api/admin/tests/bulk-delete, and surface per-row failure counts via toast."}, {"id": "test_form_modal", "label": "TestFormModal (child create/edit modal)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "lines 1641-1656", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-keyed on editingId/series/stage/subcategory so it remounts when context changes; receives relationshipSummary, available sections/stages, and full subcategory tree."}, {"id": "bulk_upload_modal", "label": "BulkUploadModal (TestsBulkUploadModal wrapper)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/TestsManager.jsx", "source_location": "line 1657", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drives bulk CSV/Excel import with onUpload and onValidate props plus a contextLabel for display."}, {"id": "tests_components", "label": "Tests UI subcomponents (Badge, StatCard, EmptyState, TestFormModal)", "file_type": "code", "source_file": "apps/admin-panel/src/features/admin/assessments-quizzes/components/TestsBadge.jsx, TestsStatCard.jsx, TestsEmptyState.jsx, TestFormModal.jsx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local UI primitives imported as TestsBadge/StatCard/EmptyState/TestFormModal; mirror shared components/* counterparts with Tests* namespacing."}, {"id": "shared_data_service", "label": "shared/lib/dataService (apiClient + adminAPI)", "file_type": "code", "source_file": "apps/admin-panel/src/shared/lib/dataService.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralized HTTP client and admin-specific API surface (getTests, createTest, updateTest, deleteTest, publishTest, unpublishTest, bulkUploadTests, etc.)."}, {"id": "validation_schemas", "label": "shared/lib/validationSchemas (testSchema + validateForm)", "file_type": "code", "source_file": "apps/admin-panel/src/shared/lib/validationSchemas", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zod-like schema-driven validation reused across admin forms; handleSubmit feeds the form fields through validateForm(testSchema, ...)."}, {"id": "use_keyboard_shortcuts", "label": "useKeyboardShortcuts hook (Save/Close bindings)", "file_type": "code", "source_file": "apps/admin-panel/src/shared/hooks/useKeyboardShortcuts", "source_location": "line 311", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wires Ctrl/Cmd+S to the active form submit and Escape to onClose; used for power-user ergonomics in test editing."}, {"id": "use_undo_toast", "label": "useUndoToast hook (optimistic delete with undo)", "file_type": "code", "source_file": "apps/admin-panel/src/shared/hooks/useUndoToast", "source_location": "line 310", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides withUndo wrapper used for soft-delete operations; exposes a transient toast that can roll back the action."}, {"id": "use_exam_categories", "label": "useExamCategories hook (categories/exams/examInfo loader)", "file_type": "code", "source_file": "apps/admin-panel/src/shared/hooks/useExamCategories", "source_location": "line 324", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides examCategories, examsFromHook, examInfo, getSubcategories, and a loading flag; the manager auto-selects the first category/exam/stage when none is active."}, {"id": "lucide_icons", "label": "lucide-