{"nodes": [{"id": "postgres-helpers.js", "label": "postgres-helpers.js", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PostgreSQL helper module providing connection pooling, schema initialization, CRUD, public_id generation, soft delete, and FK reconciliation for the TestPrep backend."}, {"id": "PostgresHelpers", "label": "PostgresHelpers class", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main class wrapping a pg Pool with CRUD helpers (find, findById, findOne, findByPublicId, insertOne, updateById, deleteById, softDelete), schema init, and FK reconciliation."}, {"id": "dbHelpers", "label": "dbHelpers singleton", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Singleton export `dbHelpers = new PostgresHelpers(pool)` used application-wide as the repository."}, {"id": "pg.Pool", "label": "pg.Pool", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "node-postgres Pool configured with DATABASE_URL, SSL rejectUnauthorized, connectionTimeoutMillis=10000, idleTimeoutMillis=30000, query_timeout=30000, max=20."}, {"id": "ENTITY_PREFIXES", "label": "ENTITY_PREFIXES registry", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen map from entity name to public_id prefix (e.g., users->usr_, tests->tst_, subjects->subj_ to avoid collision with subscriptions->subs_)."}, {"id": "PUBLIC_ID_PATTERNS", "label": "PUBLIC_ID_PATTERNS regex registry", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen map of regex patterns validating prefixed UUID format per entity type (e.g., /^usr_[0-9a-f]{8}-...UUID...$/i)."}, {"id": "JSONB_COLUMNS", "label": "JSONB_COLUMNS registry", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen map of JSONB columns per table (e.g., tests.languages, attempts.answers, users.notification_preferences) that must be stringified before insert/update."}, {"id": "TIMESTAMP_COLUMNS", "label": "TIMESTAMP_COLUMNS registry", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen map of timestamp columns per table where empty strings must be converted to NULL (tests.coming_soon_date, users.pro_expiry, live_tests.start/end_time, pro_passes)."}, {"id": "RELATIONSHIP_DEFINITIONS", "label": "RELATIONSHIP_DEFINITIONS", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen array of FK definitions (table, column, foreignTable, foreignColumn, constraintName, onDelete, indexName) used by ensureForeignKey to reconcile schema relationships."}, {"id": "parsePositiveInt", "label": "parsePositiveInt helper", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parses env values to a finite positive int or returns a fallback; used for PG pool timeout/max configuration."}, {"id": "quoteIdentifier", "label": "quoteIdentifier", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Wraps SQL identifiers in double quotes and escapes embedded quotes to prevent SQL identifier injection in dynamic DDL/DML."}, {"id": "prepareDbValues", "label": "prepareDbValues", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transforms a row by stringifying JSONB columns (via JSONB_COLUMNS) and converting empty timestamp strings to NULL (via TIMESTAMP_COLUMNS) prior to insert/update."}, {"id": "stringifyJsonbValue", "label": "stringifyJsonbValue", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON.stringify objects/arrays (except Date) for PostgreSQL JSONB; returns other values unchanged."}, {"id": "ensureTestSectionsSchema", "label": "ensureTestSectionsSchema migration", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotent migration that creates test_sections table, adds tests.section_id, test_questions.section_id, and attempts.section_scores/section_times JSONB columns."}, {"id": "ensureTestSectionsSchemaPromise", "label": "singleton-promise pattern", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Module-level Promise cache ensures ensureTestSectionsSchema runs at most once; on error the cache is cleared to allow retry."}, {"id": "tableMap", "label": "tableMap (collection -> table)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maps camelCase JS collection names to snake_case PostgreSQL table names (e.g., testSeries->test_series, studyMaterials->study_materials, videos/pdfs->study_materials)."}, {"id": "columnExistsCache", "label": "columnExistsCache", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In-memory Map caching information_schema.columns lookups keyed by `${tableName}.${columnName}` to avoid repeated catalog queries."}, {"id": "publicIdPattern", "label": "UUID + GENERATED public_id pattern", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "public_id is a GENERATED ALWAYS AS ('prefix_' || public_id_uuid::text) STORED column; inserts only need to set public_id_uuid (UUID) and the prefixed string is computed."}, {"id": "usePublicIdKillSwitch", "label": "USE_PUBLIC_ID kill switch", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "shouldUsePublicId returns false only if USE_PUBLIC_ID env is 'false', enabling instant rollback from prefixed public_ids to integer ids without DB migration."}, {"id": "softDeletePattern", "label": "Soft delete pattern (Migration 008)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "softDelete sets isActive=false, is_deleted=true, deleted_by=userId, deleted_at=now via updateById; falls back to hard delete on failure."}, {"id": "trashPattern", "label": "Trash/restore pattern", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "getTrashItems/restoreFromTrash/deleteFromTrash/emptyTrash iterate a fixed collection list scanning for isActive=false records."}, {"id": "ensureForeignKey", "label": "ensureForeignKey reconciler", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies both columns exist, inspects existing FK via information_schema, optionally drops mismatched FKs (dropIfMismatch), counts orphans, and adds FK with onDelete/onUpdate and supporting index."}, {"id": "reconcileRelationships", "label": "reconcileRelationships", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Iterates RELATIONSHIP_DEFINITIONS calling ensureForeignKey, returning the count of newly added FKs."}, {"id": "initTables", "label": "initTables (auto-migration)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numbered (0-10) idempotent schema initialization using CREATE TABLE IF NOT EXISTS and ALTER TABLE ADD COLUMN IF NOT EXISTS wrapped in DO $$ ... $$ blocks; also creates study group tables, CSRF tokens, and GIN indexes."}, {"id": "withTransaction", "label": "withTransaction", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Acquires a client, runs BEGIN/COMMIT/ROLLBACK around the callback, and releases the client in finally."}, {"id": "toCamelToSnake", "label": "toCamel / toSnake converters", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Case conversion between JS camelCase object keys and SQL snake_case columns; toCamel additionally mirrors id into _id for legacy callers."}, {"id": "findOperators", "label": "Mongo-like query operators", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "find/deleteMany support $gt, $lt, $gte, $lte, $in operators; null is rendered as IS NULL; non-numeric UUID-shaped id values are skipped to avoid bad casts."}, {"id": "resolveInternalId", "label": "resolveInternalId", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves a public_id (prefixed UUID) or numeric id string to the internal integer id used by FK columns."}, {"id": "resolveForeignKeys", "label": "resolveForeignKeys", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before insert/update, walks RELATIONSHIP_DEFINITIONS for the table and replaces any string FK value matching a public_id pattern with the resolved internal integer id."}, {"id": "ensureGinIndex", "label": "ensureGinIndex", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Creates GIN indexes (CREATE INDEX IF NOT EXISTS ... USING GIN) for JSONB/array columns to optimize containment and membership queries."}, {"id": "sslConfig", "label": "SSL configuration (CRIT-01)", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pool SSL is {rejectUnauthorized: !isDev} unless PG_SSL_REJECT_UNAUTHORIZED='false' explicitly opts out; production requires cert validation."}, {"id": "testConnection", "label": "testConnection", "file_type": "code", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs SELECT NOW() with optional exponential backoff (sleep(baseDelayMs * attempt)) for maxAttempts retries."}, {"id": "curriculumHierarchy", "label": "Curriculum hierarchy", "file_type": "concept", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "subjects (self-referential parent_id) -> subject_parts -> units -> chapters -> topics -> subtopics; each level has stage_ids INTEGER[] for stage filtering."}, {"id": "questionVersioning", "label": "Question versioning", "file_type": "concept", "source_file": "E:\\Tech\\Testprep\\Trstprep V2.1\\apps\\backend\\src\\infrastructure\\database\\postgres-helpers.js", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "question_versions stores historical versions; attempt_question_snapshots freezes question content per attempt; question_attempts.question_version_id FK provides analytics tie-in."}, {"id": "studyGroups", "label": "Study group collaboration", "file_type": "concept",