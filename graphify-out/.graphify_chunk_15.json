{"nodes": [{"id": "CARD_ORDERING_BEHAVIOR_REPORT", "label": "Card Ordering Behavior Report (HTML Document)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": null, "source_url": null, "captured_at": "March 2026", "author": null, "contributor": null, "rationale": "Comprehensive analysis of how cards are ordered across all pages in Trstprep V2.0. Merged from Design Documents + Repository Analysis."}, {"id": "CARD_ORDERING_SYSTEM", "label": "Card Ordering System", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #overview", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tech Stack: React 18+ with Vite, TailwindCSS, Node.js + Express Backend, PostgreSQL Database, JWT Authentication. 7+ Frontend Pages, 6 Admin Managers, 8+ DB Tables with Order, 20+ API Endpoints."}, {"id": "ORDERING_PATTERN_AUTO", "label": "AUTO-ORDER Pattern", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "legend section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatically reorders based on activity/usage data. Examples: Popular Test Series, Top Performers, Leaderboards."}, {"id": "ORDERING_PATTERN_FIXED", "label": "FIXED Pattern", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "legend section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stays in same place regardless of activity. Hardcoded order in component. Examples: Quick Access Grid, Category Tabs, Features Section."}, {"id": "ORDERING_PATTERN_SEMI_DYNAMIC", "label": "SEMI-DYNAMIC Pattern", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "legend section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed structure with dynamic content inside. Examples: Sub-Category Tabs, Subject Performance."}, {"id": "ORDERING_PATTERN_USER_CONTROLLED", "label": "USER-CONTROLLED Pattern", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "legend section", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "User can manually change order via filters/sorting. Examples: Test Series Grid, Attempted Tests."}, {"id": "FOUR_LAYER_ARCHITECTURE", "label": "4-Layer Ordering Architecture", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Card Ordering System uses a 4-layer architecture for flexible content positioning: Visibility Control, Prominence Control, Sequence Control, Fallback Sorting."}, {"id": "LAYER_VISIBILITY", "label": "Layer 1: Visibility Control", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #architecture layer 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fields: is_visible, is_active, visibility_status. Determines IF content should appear."}, {"id": "LAYER_PROMINENCE", "label": "Layer 2: Prominence Control", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #architecture layer 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fields: is_pinned, is_featured, priority_weight. Determines HOW PROMINENTLY content appears."}, {"id": "LAYER_SEQUENCE", "label": "Layer 3: Sequence Control", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #architecture layer 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fields: display_order, sort_mode, section_group. Determines POSITION in list."}, {"id": "LAYER_FALLBACK", "label": "Layer 4: Fallback Sorting", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #architecture layer 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fields: created_at, popularity_score, alphabetical. Used when explicit order not set."}, {"id": "MASTER_SORTING_RULE", "label": "Master Sorting Rule (SQL ORDER BY)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #architecture master sorting rule", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ORDER BY is_active DESC, is_visible DESC, is_pinned DESC, is_featured DESC, priority_weight DESC, display_order ASC NULLS LAST, created_at DESC. Universal Ordering Query Pattern."}, {"id": "PLATFORM_HIERARCHY", "label": "Platform Hierarchy Map", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #hierarchy", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exam Category (SSC, Railways, Banking) -> Exam Sub-Category -> Exam Instance -> Test Series (Tests, Questions) / Study Materials (Chapters, Videos)."}, {"id": "PROBLEM_INCONSISTENT_FIELDS", "label": "Problem: Inconsistent Field Names (CRITICAL)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #problems", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different tables use different field names: order vs sortOrder vs orderIndex causing developer confusion and bugs."}, {"id": "PROBLEM_HARDCODED_ARRAYS", "label": "Problem: Hardcoded Arrays (CRITICAL)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #problems", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quick Access items hardcoded in Dashboard.jsx and Home.jsx - requires code change to reorder, same order for all users."}, {"id": "PROBLEM_NO_BULK_REORDER", "label": "Problem: No Bulk Reorder (MEDIUM)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #problems", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Must move items one at a time - time-consuming for admins managing large content libraries."}, {"id": "PROBLEM_NO_AUDIT_TRAIL", "label": "Problem: No Audit Trail (MEDIUM)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #problems", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order changes not logged - can't track who changed what and when."}, {"id": "PROBLEM_NO_PERSONALIZATION", "label": "Problem: No User Personalization (MINOR)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #problems", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Users can't customize their view - limited UX flexibility."}, {"id": "PAGE_DASHBOARD", "label": "Dashboard Page (Dashboard.jsx)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #dashboard", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend/src/pages/dashboard/Dashboard.jsx. Main dashboard shows personalized content after user login. Cards primarily activity-based with some fixed sections."}, {"id": "PAGE_EXAMS", "label": "Exams Page (Exams.jsx)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #exams", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend/src/pages/exams/Exams.jsx. Lists exam categories and individual exams. All content is API-driven with some static configurations."}, {"id": "PAGE_TESTSERIES", "label": "Test Series Page (TestSeries.jsx)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #test-series", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend/src/pages/tests/TestSeries.jsx. Main test series listing page with multiple sections. Extensive filtering and sorting options. Uses isPinned and order fields."}, {"id": "PAGE_TESTDETAILS", "label": "Test Details Page (TestDetails.jsx)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #test-details", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend/src/pages/tests/TestDetails.jsx. Shows tests within a specific test series. Two-level navigation (Mock Tests vs PYP)."}, {"id": "PAGE_HOME", "label": "Home Page (Home.jsx)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #home", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend/src/pages/public/Home.jsx. Landing page with different content for logged-in vs non-logged-in users."}, {"id": "PAGE_STUDYMATERIAL", "label": "Study Material Page (StudyMaterial.jsx)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #study-material", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend/src/pages/study/StudyMaterial.jsx. Shows study subjects organized in groups with expandable sections."}, {"id": "DB_TABLE_TEST_SERIES", "label": "DB Table: test_series", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #database", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order field: order. Additional Fields: is_pinned, users."}, {"id": "DB_TABLE_EXAM_CATEGORIES", "label": "DB Table: exam_categories", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #database", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order field: order. Additional Fields: is_active."}, {"id": "DB_TABLE_EXAM_SUB_CATEGORIES", "label": "DB Table: exam_sub_categories", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #database", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order field: order. Additional Fields: parent_category_id."}, {"id": "DB_TABLE_STUDY_MATERIALS", "label": "DB Table: study_materials", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #database", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order field: order."}, {"id": "ADMIN_API_TEST_SERIES", "label": "Admin API: /api/admin/test-series", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #admin-control", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET (list), POST (create, auto-assigns next order), PUT (update, includes order reordering logic), DELETE (soft delete). File: apps/backend/src/api/routes/admin.js"}, {"id": "ADMIN_API_EXAM_CATEGORIES", "label": "Admin API: /api/admin/exam-categories", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #admin-control", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET, POST, PUT, DELETE endpoints. Includes order field."}, {"id": "ADMIN_API_STUDY_MATERIALS", "label": "Admin API: /api/admin/study-materials", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #admin-control", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET, POST, PUT (includes reordering logic), DELETE endpoints."}, {"id": "MIGRATION_ROADMAP", "label": "Migration Roadmap (5 Phases)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #api timeline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phase 1: Database Schema Updates. Phase 2: Data Backfill. Phase 3: Backend API Implementation. Phase 4: Frontend Updates. Phase 5: Testing & Rollout."}, {"id": "QUICK_ACCESS_GRID", "label": "Quick Access Grid (FIXED card)", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #dashboard", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8-item grid of navigation shortcuts (Live Tests, Quizzes, PYQ, Practice, Analysis, Videos, Attempted, Materials). Always stays in same order - hardcoded array definition in Dashboard.jsx."}, {"id": "POPULAR_TEST_SERIES_SORT", "label": "Popular Test Series Sort Logic", "file_type": "document", "source_file": "docs/features/CARD_ORDERING_BEHAVIOR_REPORT.html", "source_location": "section #test-series", "source_url": null, "captured_at": null, "author": null, "cont