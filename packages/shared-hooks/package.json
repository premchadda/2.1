{
  "name": "@trstprep/shared-hooks",
  "version": "1.0.0",
  "description": "Shared React hooks for Trstprep apps",
  "main": "index.js",
  "types": "types/index.d.ts",
  "type": "module",
  "files": [
    "*.js",
    "*.jsx",
    "src/EmptyState.jsx",
    "src/**",
    "types/"
  ],
  "exports": {
    ".": "./index.js",
    "./useStages": "./useStages.js",
    "./useExamCategories": "./useExamCategories.js",
    "./useTestCategories": "./useTestCategories.js",
    "./useProPass": "./useProPass.js",
    "./useFormManager": "./useFormManager.js",
    "./useGenericCRUD": "./useGenericCRUD.js",
    "./useDraggableScroll": "./useDraggableScroll.js",
    "./useWebSocket": "./useWebSocket.js",
    "./useUndoRedo": "./useUndoRedo.js",
    "./useDebounce": "./useDebounce.js",
    "./useSearch": "./useSearch.js",
    "./searchUtils": "./searchUtils.js",
    "./usePwaInstall": "./usePwaInstall.js",
    "./apiClientConfig": "./apiClientConfig.js",
    "./EmptyState": "./src/EmptyState.jsx",
    "./src/EmptyState.jsx": "./src/EmptyState.jsx",
    "./ThemeContext": "./ThemeContext.jsx",
    "./ThemeContext.jsx": "./ThemeContext.jsx"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "socket.io-client": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  }
}
