{
  "name": "trstprep-monorepo",
  "version": "2.1.0",
  "description": "Trstprep - India's #1 Platform for SSC & Railway Exam Preparation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-sequential.mjs",
    "dev:seq": "node scripts/dev-sequential.mjs",
    "dev:turbo": "turbo dev --ui=stream",
    "build": "node scripts/build.mjs",
    "build:all": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "dev:backend": "pnpm --filter trstprep-backend run dev",
    "dev:frontend": "pnpm --filter trstprep-frontend run dev",
    "dev:admin": "pnpm --filter trstprep-admin run dev",
    "build:backend": "turbo build --filter=trstprep-backend",
    "build:frontend": "turbo build --filter=trstprep-frontend",
    "build:admin": "turbo build --filter=trstprep-admin",
    "upgrade": "pnpm update -r --interactive --latest",
    "prepare": "node -e \"if (!process.env.CI && process.env.NODE_ENV !== 'production') { try { require('child_process').execSync('husky install', { stdio: 'ignore' }); } catch (e) {} }\"",
    "load-test": "k6 run tests/load/api.js",
    "load-test:auth": "k6 run tests/load/auth.js",
    "load-test:api": "k6 run tests/load/api.js",
    "load-test:realtime": "k6 run tests/load/realtime.js",
    "ai:extract": "uv run python apps/backend/src/modules/ai/extract_pdf.py",
    "py:setup": "uv venv .venv && uv pip install -e ."
  },
  "dependencies": {
    "turbo": "^2.10.12"
  },
  "devDependencies": {
    "agentation": "^3.0.2",
    "chokidar": "^3.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.12",
    "@rollup/rollup-linux-x64-gnu": "^4.62.5",
    "@rollup/rollup-linux-x64-musl": "^4.62.5"
  },
  "overrides": {
    "qs": "^6.16.0",
    "minimatch": "10.2.5",
    "tar": "^7.5.11",
    "@tootallnate/once": "^3.0.0",
    "fast-xml-parser": "^4.4.1",
    "flatted": "^3.3.1",
    "lodash": "^4.17.21",
    "vite": "^6.4.2",
    "axios": "^1.20.0",
    "happy-dom": "^20.10.6",
    "ws": "^8.20.2",
    "nodemailer": "^9.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
