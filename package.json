{
  "name": "trstprep-monorepo",
  "version": "2.1.0",
  "description": "Trstprep - India's #1 Platform for SSC & Railway Exam Preparation",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "dev:backend": "turbo dev --filter=trstprep-backend",
    "dev:frontend": "turbo dev --filter=trstprep-frontend",
    "dev:admin": "turbo dev --filter=trstprep-admin",
    "build:backend": "turbo build --filter=trstprep-backend",
    "build:frontend": "turbo build --filter=trstprep-frontend",
    "build:admin": "turbo build --filter=trstprep-admin",
    "upgrade": "ncu -u",
    "prepare": "husky install"
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^22.1.0",
    "prettier": "^3.5.3",
    "turbo": "^2.10.0"
  },
  "overrides": {
    "qs": "6.15.0",
    "minimatch": "10.2.5",
    "tar": "^7.5.11",
    "@tootallnate/once": "^3.0.0",
    "fast-xml-parser": "^4.4.1",
    "flatted": "^3.3.1",
    "lodash": "^4.17.21",
    "vite": "^6.4.2",
    "axios": "^1.18.0",
    "happy-dom": "^20.10.6",
    "ws": "^8.20.2",
    "nodemailer": "^9.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@9.0.0"
}
