# TRSTPREP Root Environment Variables Example
# Copy this file to .env and configure as needed.

# ─── Server & Environment ───────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
FRONTEND_URL=https://localhost:3000

# ─── Database (PostgreSQL / Supabase) ───────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trstprep
USE_PUBLIC_ID=true
ALLOW_LEGACY_ID=true
LEGACY_ID_SUNSET_DATE=2026-06-01

# ─── Redis & Queue ──────────────────────────────────────────────────────────
# Local dev: REDIS_URL=redis://localhost:6379 (run a local Redis, or unset to
# use the in-memory/file cache fallback — queues and Socket.IO adapter are
# disabled without Redis).
# Docker compose: the bundled `redis` service (AOF persistence, 256MB LRU cap,
# healthchecked) is reached at redis://redis:6379; leave REDIS_URL unset to
# use it, or point here at managed Redis (Upstash/ElastiCache) instead.
REDIS_URL=redis://localhost:6379

# Connection tuning (see apps/backend/src/infrastructure/cache/redisClient.js)
# REDIS_CONNECT_TIMEOUT_MS=3000
# REDIS_COMMAND_TIMEOUT_MS=750
# REDIS_MAX_RETRIES_PER_REQUEST=1
# REDIS_TLS=true                      # for rediss:// managed endpoints
# REDIS_TLS_REJECT_UNAUTHORIZED=true

# Queue Pruning & Workers
REMOVE_ON_COMPLETE=200
REMOVE_ON_FAIL=500
WORKER_ANALYTICS_CONCURRENCY=4
WORKER_LEADERBOARD_CONCURRENCY=2
WORKER_NOTIFICATIONS_CONCURRENCY=5
WORKER_RECOMMENDATIONS_CONCURRENCY=2

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=generate_a_strong_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=generate_a_different_strong_random_secret_refresh
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_2FA_SECRET=set_a_third_independent_secret_for_2fa_tokens
JWT_RESET_SECRET=set_a_fourth_independent_secret_for_reset_tokens

# DB_ENCRYPTION_KEY is REQUIRED at boot (env-validation.mjs) — it encrypts
# phone/dob at rest. 32+ chars, never equal to JWT_SECRET.
DB_ENCRYPTION_KEY=generate_another_32char_secret_not_equal_to_jwt_secret
DATABASE_READ_URL=postgresql://postgres:postgres@localhost:5432/trstprep
PG_SSL_REJECT_UNAUTHORIZED=true

# Session / cookie behaviour
SESSION_IDLE_TIMEOUT_MIN=30
SESSION_IDLE_REMEMBER_ME_TIMEOUT_MIN=10080
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
ADMIN_IDLE_TIMEOUT_MIN=20
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Admin layer — ADMIN_API_KEY is REQUIRED in production (the admin guard now
# refuses admin traffic with a 500 when it is missing instead of silently
# skipping the check).
ADMIN_API_KEY=generate_an_admin_api_key_used_by_the_admin_panel
ADMIN_PANEL_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174
CORS_ORIGIN=http://localhost:3000
ALLOWED_LAN_HOSTS=
ALLOWED_ADMIN_IPS=
CSRF_HMAC_PEPPER=generate_a_csrf_pepper_at_least_32_chars
CSRF_PEPPER=generate_a_csrf_pepper_at_least_32_chars

# AI gateway (OpenRouter multi-provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_DAILY_TOKEN_LIMIT=50000
AI_FREE_HOURLY_LIMIT=30
AI_PRO_HOURLY_LIMIT=120

# Auth providers
GOOGLE_CLIENT_ID=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Storage Settings ────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_BASE_PATH=./uploads
BASE_URL=https://localhost:5001

# S3 Configuration (if provider is s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Supabase Storage Configuration (if provider is supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# ─── Email (SMTP) Settings ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Trstprep <noreply@trstprep.com>

# ─── Sentry & Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=

# ─── TLS / Let's Encrypt (certbot) ──────────────────────────────────────────
# Required for automated initial certificate issuance via deploy/setup-ssl.sh
# (docker compose --profile init run --rm certbot-init). Both MUST be set in
# your .env before running SSL setup.
DOMAIN=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com

# ─── Grafana (monitoring dashboard) ─────────────────────────────────────────
# Required by the grafana service in docker-compose.yml.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password

# ─── Rate Limiting Configurations ───────────────────────────────────────────
DISABLE_RATE_LIMITER=false
RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=500
